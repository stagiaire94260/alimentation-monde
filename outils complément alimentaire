<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}

:root{
  --red:#A91B18;
  --red-d:#8f1614;
  --burgundy:#700243;
  --cream:#FBF6F6;
  --cream2:#F7EEEE;
  --cream3:#F3EEEE;
  --white:#FFFEFE;
  --text:#3F0405;
  --muted:#6F4A4C;
  --soft:#8D6A6B;
  --line:rgba(169,27,24,.10);
  --line-s:rgba(169,27,24,.20);
  --shadow:0 16px 40px rgba(63,4,5,.12);
  --shadow-sm:0 6px 20px rgba(63,4,5,.07);
}

html{
  scroll-behavior:smooth;
  -webkit-text-size-adjust:100%;
}

body{
  font-family:"Inter","Helvetica Neue",Helvetica,Arial,sans-serif !important;
  background:var(--cream);
  color:var(--text);
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}

/* Force absolue de la typo partout */
body,
body *:not(i):not(svg):not(path):not(img),
.hero,
.hero *,
.wrap,
.wrap *,
.test-wrap,
.test-wrap *,
.cards-area,
.cards-area *,
.modal,
.modal *,
.modal-header,
.modal-header *,
.modal-body,
.modal-body *,
.modal-tabs,
.modal-tabs *,
button,
input,
textarea,
select,
label,
p,
span,
div,
h1,h2,h3,h4,h5,h6{
  font-family:"Inter","Helvetica Neue",Helvetica,Arial,sans-serif !important;
}

/* HERO */
.hero{
  padding:2.5rem 1rem 2rem;
  text-align:center;
  background:linear-gradient(150deg,#f7eeee 0%,#fbf6f6 50%,#f5eef7 100%);
  border-bottom:1px solid var(--line);
  position:relative;
  overflow:hidden;
}

.hero::before{
  content:'';
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(ellipse at 15% 25%,rgba(169,27,24,.07) 0%,transparent 55%),
    radial-gradient(ellipse at 85% 75%,rgba(112,2,67,.05) 0%,transparent 55%);
}

.hero-badge{
  display:inline-flex;
  align-items:center;
  font-size:11px;
  font-weight:800;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--red);
  background:rgba(169,27,24,.07);
  border:1px solid rgba(169,27,24,.12);
  border-radius:999px;
  padding:7px 12px;
  margin-bottom:1rem;
}

.hero h1{
  font-size:clamp(1.8rem,5.5vw,3.4rem);
  font-weight:800;
  line-height:1.08;
  letter-spacing:-.03em;
  margin-bottom:1rem;
  color:var(--text);
}

.hero h1 em{
  font-style:italic;
  font-weight:400;
  color:var(--red);
}

.hero-lead{
  font-size:14px;
  color:var(--muted);
  max-width:560px;
  margin:0 auto 1.75rem;
  line-height:1.75;
}

.hero-stats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:clamp(.5rem,2vw,.8rem);
  max-width:400px;
  margin:0 auto;
}

.stat-card{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:14px;
  padding:.75rem 1rem;
  text-align:center;
  box-shadow:var(--shadow-sm);
}

.stat-num{
  font-size:clamp(1.3rem,3.5vw,1.9rem);
  font-weight:800;
  color:var(--red);
  letter-spacing:-.02em;
}

.stat-lbl{
  font-size:11px;
  color:var(--soft);
  margin-top:2px;
  line-height:1.4;
}

/* SHARED */
.wrap{
  max-width:880px;
  margin:0 auto;
  padding:0 1rem;
}

.sec-eyebrow{
  font-size:11px;
  font-weight:800;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:var(--red);
  margin-bottom:.5rem;
}

.sec-title{
  font-size:clamp(1.35rem,3.5vw,2rem);
  font-weight:800;
  letter-spacing:-.025em;
  color:var(--text);
}

.sec-title em{
  font-style:italic;
  font-weight:400;
  color:var(--red);
}

.sec-sub{
  font-size:13px;
  color:var(--muted);
  margin-top:.35rem;
}

.sec-head{
  text-align:center;
  margin-bottom:1.6rem;
}

/* WHY */
.why-section{
  padding:clamp(2rem,5vw,3.5rem) 0;
}

.why-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));
  gap:11px;
}

.why-card{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:15px;
  padding:1.2rem 1.3rem;
  border-top:3px solid var(--red);
}

.why-card h3{
  font-size:13.5px;
  font-weight:800;
  margin-bottom:5px;
  color:var(--text);
}

.why-card p{
  font-size:12px;
  color:var(--muted);
  line-height:1.65;
}

/* TEST */
.test-section{
  padding:0 0 clamp(2rem,4vw,3rem);
}

.test-wrap{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:20px;
  overflow:hidden;
  box-shadow:var(--shadow-sm);
}

.test-inner{
  padding:1rem;
}

.test-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(min(100%,240px),1fr));
  gap:8px;
}

.topt{
  display:flex;
  cursor:pointer;
}

.topt input{
  display:none;
}

.topt-inner{
  display:flex;
  align-items:flex-start;
  gap:10px;
  width:100%;
  background:var(--cream2);
  border:1px solid var(--line);
  border-radius:12px;
  padding:11px 13px;
  transition:all .15s;
}

.topt:hover .topt-inner{
  border-color:var(--line-s);
  background:var(--cream3);
}

.topt input:checked~.topt-inner{
  background:rgba(169,27,24,.08);
  border-color:rgba(169,27,24,.3);
}

.topt input:checked~.topt-inner .topt-check{
  background:var(--red);
  border-color:var(--red);
  color:#fff;
}

.topt input:checked~.topt-inner span{
  color:var(--red);
  font-weight:700;
}

.topt-check{
  width:18px;
  height:18px;
  border-radius:5px;
  border:1.5px solid rgba(169,27,24,.28);
  flex-shrink:0;
  margin-top:1px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:10px;
  color:transparent;
  transition:all .15s;
  background:var(--white);
}

.topt span{
  font-size:12.5px;
  color:var(--muted);
  line-height:1.45;
}

.test-btn{
  display:block;
  margin:1.2rem auto 0;
  background:var(--red);
  color:#fff;
  border:none;
  border-radius:999px;
  padding:12px 32px;
  font-size:13px;
  font-weight:800;
  cursor:pointer;
  transition:all .18s;
  box-shadow:0 8px 20px rgba(169,27,24,.22);
}

.test-btn:hover{
  background:var(--red-d);
  transform:translateY(-1px);
}

#test-res{
  margin-top:1.4rem;
}

.tr-empty{
  text-align:center;
  font-size:13px;
  color:var(--soft);
  padding:.25rem 0;
}

.tr-grid{
  display:grid;
  gap:9px;
  margin-bottom:1.1rem;
}

.tr-item{
  border-radius:14px;
  border:1px solid var(--line);
  overflow:hidden;
  background:var(--cream2);
}

.tr-btn{
  width:100%;
  border:none;
  background:transparent;
  padding:12px 14px;
  text-align:left;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.tr-sym{
  font-size:13px;
  font-weight:800;
  color:var(--text);
  line-height:1.3;
}

.tr-piste{
  font-size:11px;
  color:var(--red);
  font-weight:700;
  margin-top:2px;
}

.tr-arrow{
  font-size:20px;
  color:var(--red);
  transition:transform .2s;
  flex-shrink:0;
  line-height:1;
}

.tr-item.open .tr-arrow{
  transform:rotate(45deg);
}

.tr-body{
  display:none;
  padding:0 14px 12px;
  border-top:1px solid var(--line);
}

.tr-item.open .tr-body{
  display:block;
}

.tr-block{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:11px;
  padding:10px 12px;
  margin-top:8px;
}

.tr-blabel{
  font-size:10px;
  font-weight:800;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--red);
  margin-bottom:4px;
}

.tr-btext{
  font-size:12.5px;
  color:var(--muted);
  line-height:1.65;
}

.tr-comps{
  display:flex;
  flex-wrap:wrap;
  gap:5px;
  margin-top:7px;
}

.tr-ctag{
  font-size:11.5px;
  padding:4px 11px;
  border-radius:999px;
  background:rgba(169,27,24,.07);
  color:var(--red);
  border:1px solid rgba(169,27,24,.15);
  cursor:pointer;
  font-weight:700;
  transition:all .15s;
}

.tr-ctag:hover{
  background:var(--red);
  color:#fff;
}

.tr-note{
  background:var(--cream3);
  border-radius:12px;
  padding:10px 13px;
  font-size:12px;
  color:var(--muted);
  line-height:1.65;
  border:1px solid var(--line);
}

/* CAT NAV */
.cat-nav{
  display:flex;
  overflow-x:auto;
  scrollbar-width:none;
  -webkit-overflow-scrolling:touch;
  gap:6px;
  padding:0 1rem 1.2rem;
  max-width:880px;
  margin:0 auto;
  flex-wrap:nowrap;
}

.cat-nav::-webkit-scrollbar{
  display:none;
}

.cat-btn{
  flex:none;
  padding:8px 16px;
  border-radius:999px;
  font-size:12px;
  font-weight:700;
  border:1px solid var(--line);
  background:var(--white);
  color:var(--muted);
  cursor:pointer;
  transition:all .18s;
  white-space:nowrap;
}

.cat-btn:hover{
  border-color:var(--line-s);
  color:var(--text);
}

.cat-btn.active{
  background:var(--red);
  color:#fff;
  border-color:var(--red);
}

/* CARDS */
.cards-area{
  max-width:880px;
  margin:0 auto;
  padding:0 1rem 3rem;
}

.cards-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));
  gap:12px;
}

.comp-card{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:18px;
  overflow:hidden;
  cursor:pointer;
  transition:transform .18s,box-shadow .18s;
  box-shadow:var(--shadow-sm);
}

.comp-card:hover{
  transform:translateY(-3px);
  box-shadow:0 14px 36px rgba(63,4,5,.13);
}

.card-top{
  padding:1.1rem 1.3rem .85rem;
  border-bottom:1px solid var(--line);
}

.card-cat-tag{
  display:inline-block;
  font-size:10px;
  font-weight:800;
  letter-spacing:.09em;
  text-transform:uppercase;
  padding:3px 8px;
  border-radius:7px;
  margin-bottom:.45rem;
}

.tag-sante,.tag-immunite{background:rgba(169,27,24,.07);color:var(--red);}
.tag-sport{background:rgba(30,79,160,.08);color:#1e4fa0;}
.tag-sommeil{background:rgba(90,45,138,.08);color:#5a2d8a;}
.tag-energie{background:rgba(122,80,16,.08);color:#7a5010;}

.card-name{
  font-size:clamp(.95rem,2.5vw,1.15rem);
  font-weight:800;
  line-height:1.2;
  margin-bottom:.2rem;
  letter-spacing:-.02em;
  color:var(--text);
}

.card-brand{
  font-size:10.5px;
  color:var(--soft);
}

.card-body{
  padding:.85rem 1.3rem 1.1rem;
}

.card-desc{
  font-size:12.5px;
  color:var(--muted);
  line-height:1.6;
  margin-bottom:.75rem;
}

.card-chips{
  display:flex;
  flex-wrap:wrap;
  gap:5px;
}

.chip{
  font-size:11px;
  padding:3px 9px;
  border-radius:999px;
  background:var(--cream2);
  color:var(--muted);
  border:1px solid var(--line);
  font-weight:600;
}

.chip.blue{background:rgba(30,79,160,.06);color:#1e4fa0;border-color:rgba(30,79,160,.12);}
.chip.gold{background:rgba(122,80,16,.07);color:#7a5010;border-color:rgba(122,80,16,.13);}
.chip.violet{background:rgba(90,45,138,.07);color:#5a2d8a;border-color:rgba(90,45,138,.13);}
.chip.rose{background:rgba(169,27,24,.07);color:var(--red);border-color:rgba(169,27,24,.14);}

/* MODAL / POP UP */
.modal-overlay{
  display:flex;
  position:fixed;
  inset:0;
  z-index:1000;
  background:rgba(20,3,3,.52);
  backdrop-filter:blur(5px);
  -webkit-backdrop-filter:blur(5px);
  align-items:center;
  justify-content:center;
  padding:16px;
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transition:opacity .24s ease, visibility .24s ease;
}

.modal-overlay.open{
  opacity:1;
  visibility:visible;
  pointer-events:auto;
}

.modal{
  background:var(--cream);
  border-radius:24px;
  width:100%;
  max-width:620px;
  max-height:min(88vh,780px);
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
  box-shadow:0 24px 80px rgba(63,4,5,.22);
  overscroll-behavior:contain;

  opacity:0;
  transform:
    translate3d(var(--modal-start-x,0), var(--modal-start-y,24px), 0)
    scale(var(--modal-start-scale,.96));
  transform-origin:center top;
  transition:
    transform .34s cubic-bezier(.22,1,.36,1),
    opacity .24s ease;
  will-change:transform, opacity;
}

.modal-overlay.open .modal{
  opacity:1;
  transform:translate3d(0,0,0) scale(1);
}

.modal-header{
  padding:1rem 1rem .85rem;
  border-bottom:1px solid var(--line);
  position:sticky;
  top:0;
  background:var(--cream2);
  z-index:2;
  border-radius:24px 24px 0 0;
}

@media(max-width:700px){
  .modal-overlay{
    align-items:flex-start;
    justify-content:center;
    padding:clamp(18px,5vw,28px) 12px max(18px, env(safe-area-inset-bottom));
  }

  .modal{
    border-radius:22px;
    max-width:100%;
    max-height:82vh;
  }

  .modal-header{
    border-radius:22px 22px 0 0;
  }
}

.modal-close{
  position:absolute;
  top:14px;
  right:14px;
  background:var(--red);
  color:#fff;
  border:none;
  border-radius:14px;
  width:56px;
  height:56px;
  cursor:pointer;
  font-size:22px;
  font-weight:700;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:background .15s,transform .15s;
  box-shadow:0 8px 18px rgba(169,27,24,.18);
}

.modal-close:hover{
  background:var(--red-d);
  transform:scale(.98);
}

.modal-tag{
  display:inline-block;
  font-size:11px;
  font-weight:800;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--red);
  background:rgba(169,27,24,.07);
  border:1px solid rgba(169,27,24,.12);
  border-radius:999px;
  padding:8px 14px;
  margin-bottom:.8rem;
  line-height:1.3;
}

.modal-name{
  font-size:clamp(1.8rem,4vw,2.4rem);
  font-weight:800;
  letter-spacing:-.03em;
  line-height:1.08;
  margin-bottom:.3rem;
  color:var(--text);
  padding-right:84px;
}

.modal-brand{
  font-size:14px;
  color:var(--soft);
  line-height:1.5;
  padding-right:84px;
}

.modal-tabs{
  display:flex;
  border-bottom:1px solid var(--line);
  overflow-x:auto;
  scrollbar-width:none;
  background:var(--cream2);
  -webkit-overflow-scrolling:touch;
}

.modal-tabs::-webkit-scrollbar{
  display:none;
}

.mtab{
  flex:none;
  padding:14px 18px;
  font-size:13px;
  font-weight:700;
  color:var(--soft);
  background:none;
  border:none;
  border-bottom:3px solid transparent;
  cursor:pointer;
  white-space:nowrap;
  transition:all .16s;
}

.mtab:hover{
  color:var(--muted);
}

.mtab.active{
  color:var(--red);
  border-bottom-color:var(--red);
  background:var(--cream);
}

.modal-body{
  padding:1rem;
}

.mtab-content{
  display:none;
}

.mtab-content.active{
  display:block;
}

.m-block{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:18px;
  padding:18px 18px;
  margin-bottom:10px;
  font-size:15px;
  color:var(--muted);
  line-height:1.9;
}

.m-block:last-child{
  margin-bottom:0;
}

.m-block strong{
  color:var(--text);
  font-weight:800;
}

.m-block.warn{
  border-left:5px solid var(--red);
  background:rgba(169,27,24,.04);
}

.m-lbl{
  font-size:10px;
  font-weight:800;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--red);
  margin:1rem 0 .35rem;
}

.m-lbl:first-child{
  margin-top:0;
}

.d-card{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:14px;
  padding:.95rem 1rem;
  margin-bottom:7px;
}

.d-card:last-child{
  margin-bottom:0;
}

.d-title{
  font-size:13px;
  font-weight:800;
  color:var(--text);
  margin-bottom:4px;
}

.d-detail{
  font-size:12.5px;
  color:var(--muted);
  line-height:1.6;
}

.syn-row{
  display:flex;
  align-items:flex-start;
  gap:10px;
  padding:10px 0;
  border-bottom:1px solid var(--line);
}

.syn-row:last-child{
  border-bottom:none;
}

.syn-ico{
  width:30px;
  height:30px;
  border-radius:9px;
  flex-shrink:0;
  background:rgba(169,27,24,.07);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:10.5px;
  font-weight:800;
  color:var(--red);
}

.syn-text strong{
  display:block;
  font-size:12.5px;
  font-weight:800;
  color:var(--text);
  margin-bottom:2px;
}

.syn-text span{
  font-size:12px;
  color:var(--muted);
  line-height:1.5;
}

.c-row{
  display:flex;
  align-items:center;
  gap:9px;
  margin-bottom:8px;
}

.c-lbl{
  width:clamp(100px,25vw,140px);
  flex-shrink:0;
  font-size:12px;
  color:var(--muted);
}

.c-track{
  flex:1;
  height:6px;
  background:rgba(169,27,24,.08);
  border-radius:999px;
  overflow:hidden;
}

.c-fill{
  height:100%;
  border-radius:999px;
  background:var(--red);
}

.c-pct{
  font-size:11px;
  color:var(--soft);
  width:32px;
  text-align:right;
  font-weight:700;
}

/* FOOTER */
footer{
  text-align:center;
  padding:clamp(2rem,4vw,3rem) 1.5rem clamp(1.5rem,3vw,2.5rem);
  border-top:1px solid var(--line);
  margin-top:1rem;
  color:var(--soft);
  font-size:12px;
  line-height:1.9;
}

footer em{
  font-style:italic;
  color:var(--muted);
}

/* RESPONSIVE */
@media(max-width:700px){
  .hero{
    padding:2rem 1rem 1.75rem;
  }

  .hero h1{
    font-size:1.75rem;
  }

  .hero-stats{
    grid-template-columns:1fr 1fr;
    max-width:100%;
  }

  .sec-title{
    font-size:1.35rem;
  }

  .why-section{
    padding:1.75rem 0;
  }

  .wrap{
    padding:0 1rem;
  }

  .test-grid{
    grid-template-columns:1fr !important;
  }

  .cards-grid{
    grid-template-columns:1fr !important;
  }

  .cat-nav{
    flex-wrap:nowrap;
    padding-bottom:1rem;
  }

  .modal{
    max-height:90vh;
    max-width:100%;
    border-radius:22px 22px 0 0;
  }

  .modal-header{
    padding:1rem 1rem .85rem;
    border-radius:22px 22px 0 0;
  }

  .modal-close{
    top:12px;
    right:12px;
    width:50px;
    height:50px;
    font-size:20px;
    border-radius:14px;
  }

  .modal-name{
    font-size:1.2rem;
    line-height:1.1;
    padding-right:68px;
