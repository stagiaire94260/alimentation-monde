function runTest(){
 const checked=[...document.querySelectorAll('#test-grid input:checked')];
 const area=document.getElementById('test-res');
 if(!checked.length){area.innerHTML='<p class="tr-empty">Coche au moins un symptôme pour voir tes pistes.</p>';return;}
 const items=checked.map(cb=>{
  const d=TD[cb.value];
  const links=(d.ids||[]).map(id=>{const c=C.find(x=>x.id===id);return c?`<button class="tr-ctag" onclick="openModal(${c.id}, event)">${c.nom}</button>`:''}).join('');
  return `<div class="tr-item open">
   <button class="tr-btn" onclick="this.parentElement.classList.toggle('open')" type="button">
    <div><div class="tr-sym">${d.s}</div><div class="tr-piste">${d.p}</div></div>
    <span class="tr-arrow">+</span>
   </button>
   <div class="tr-body">
    <div class="tr-block"><div class="tr-blabel">Ce que ça peut vouloir dire</div><p class="tr-btext">${d.e}</p></div>
    <div class="tr-block"><div class="tr-blabel">Par où commencer</div><p class="tr-btext">${d.c}</p></div>
    ${links?`<div class="tr-block"><div class="tr-blabel">Compléments associés — clique pour ouvrir la fiche</div><div class="tr-comps">${links}</div></div>`:''}
   </div>
  </div>`;
 }).join('');
 area.innerHTML=`
  <div style="margin-bottom:.9rem;padding-top:.2rem;">
   <div class="sec-eyebrow" style="text-align:left;font-size:10px;margin-bottom:.2rem;">${checked.length} signal${checked.length>1?'s':''} détecté${checked.length>1?'s':''}</div>
   <div style="font-size:15px;font-weight:800;letter-spacing:-.02em;color:var(--text);">Tes pistes nutritionnelles personnalisées</div>
  </div>
  <div class="tr-grid">${items}</div>
  <div class="tr-note"><strong>Important :</strong> Ce test est indicatif et ne remplace ni une prise de sang ni un avis médical. Si plusieurs signaux reviennent régulièrement, consulter un professionnel de santé reste la meilleure démarche.</div>`;
 area.scrollIntoView({behavior:'smooth',block:'start'});
}

function renderCards(cat){
 const grid=document.getElementById('cards-grid');
 const list=cat==='all'?C:C.filter(c=>c.cat===cat);
 grid.innerHTML=list.map(c=>`
 <div class="comp-card" onclick="openModal(${c.id}, event)">
   <div class="card-top">
    <div class="card-cat-tag ${c.tc}">${c.tl}</div>
    <div class="card-name">${c.nom}</div>
    <div class="card-brand">${c.marque}</div>
   </div>
   <div class="card-body">
    <p class="card-desc">${c.desc}</p>
    <div class="card-chips">${c.chips.map(ch=>`<span class="chip ${c.cc}">${ch}</span>`).join('')}</div>
   </div>
  </div>`).join('');
}

function filterCat(cat,btn){
 document.querySelectorAll('.cat-btn').forEach(b=>b.classList.remove('active'));
 btn.classList.add('active');renderCards(cat);
}


function openModal(id, ev){
  const c = C.find(x => x.id === id);
  if(!c) return;

  document.getElementById('m-tag').textContent = c.tl;
  document.getElementById('m-name').textContent = c.nom;
  document.getElementById('m-brand').textContent = c.marque;

  document.getElementById('mtab-pourquoi').innerHTML = `
    <div class="m-block"><strong>Pourquoi se supplémenter ?</strong><br><br>${c.pq}</div>
    ${c.ca ? `<div class="m-block warn"><strong>À savoir :</strong> ${c.ca}</div>` : ''}
  `;

  document.getElementById('mtab-bienfaits').innerHTML = c.bf.map(b => `
    <div class="m-lbl">${b.t}</div>
    <div class="m-block">${b.d}</div>
  `).join('');

  document.getElementById('mtab-dosage').innerHTML = c.ds.map(d => `
    <div class="d-card">
      <div class="d-title">${d.t}</div>
      <div class="d-detail">${d.d}</div>
    </div>
  `).join('');

  document.getElementById('mtab-synergie').innerHTML = `
    <p style="font-size:12px;color:var(--soft);margin-bottom:1rem;line-height:1.6;">
      Compléments qui fonctionnent en synergie avec celui-ci :
    </p>
    ${c.sy.map(s => `
      <div class="syn-row">
        <div class="syn-ico">${s.icon}</div>
        <div class="syn-text">
          <strong>${s.titre}</strong>
          <span>${s.desc}</span>
        </div>
      </div>
    `).join('')}
  `;

  document.getElementById('mtab-carence').innerHTML = c.cr[0].p === 0
    ? `<div class="m-block"><strong>${c.nom}</strong> n'est pas un complément de carence — c'est un optimiseur de performance ou un adaptogène. Son usage est basé sur l'objectif et non sur un déficit mesurable.</div>`
    : `
      <p style="font-size:12px;color:var(--soft);margin-bottom:1rem;line-height:1.6;">
        Pourcentage estimé de personnes en déficit selon les populations :
      </p>
      ${c.cr.map(r => `
        <div class="c-row">
          <span class="c-lbl">${r.n}</span>
          <div class="c-track"><div class="c-fill" style="width:${r.p}%"></div></div>
          <span class="c-pct">${r.p}%</span>
        </div>
      `).join('')}
      <div class="m-block" style="margin-top:.9rem;font-size:12px;">
        Données issues d'études épidémiologiques et de l'étude française Esteban (2014-2016). Ces chiffres représentent les déficits subcliniques.
      </div>
    `;

  document.querySelectorAll('.mtab,.mtab-content').forEach(el => el.classList.remove('active'));
  document.querySelector('.mtab').classList.add('active');
  document.getElementById('mtab-pourquoi').classList.add('active');

  const overlay = document.getElementById('modal-overlay');
  const modal = document.getElementById('modal');

  overlay.classList.remove('open');

  let startX = '0px';
  let startY = '24px';
  let startScale = '.96';

  if(ev && ev.currentTarget){
    const triggerRect = ev.currentTarget.getBoundingClientRect();

    const viewportW = window.innerWidth;
    const viewportH = window.innerHeight;

    const modalTargetW = Math.min(620, viewportW - 24);
    const modalTargetH = Math.min(viewportH * 0.82, 780);

    const targetLeft = (viewportW - modalTargetW) / 2;

    const marginTop = 12;
    const marginBottom = 12;

    let targetTop = triggerRect.top - 20;

    const maxTop = viewportH - modalTargetH - marginBottom;

    if(targetTop < marginTop) targetTop = marginTop;
    if(targetTop > maxTop) targetTop = maxTop;

    const triggerCenterX = triggerRect.left + (triggerRect.width / 2);
    const triggerTopY = triggerRect.top + 12;

    const deltaX = triggerCenterX - (targetLeft + modalTargetW / 2);
    const deltaY = triggerTopY - targetTop;

    startX = `${deltaX}px`;
    startY = `${deltaY}px`;
    startScale = viewportW <= 700 ? '.94' : '.96';

    overlay.style.alignItems = 'flex-start';
    overlay.style.justifyContent = 'center';
    overlay.style.paddingTop = `${targetTop}px`;
    overlay.style.paddingRight = '12px';
    overlay.style.paddingBottom = '12px';
    overlay.style.paddingLeft = '12px';
  } else {
    overlay.style.alignItems = 'center';
    overlay.style.justifyContent = 'center';
    overlay.style.padding = '16px';
  }

  modal.style.setProperty('--modal-start-x', startX);
  modal.style.setProperty('--modal-start-y', startY);
  modal.style.setProperty('--modal-start-scale', startScale);

  document.body.style.overflow = 'hidden';

  requestAnimationFrame(() => {
    modal.scrollTop = 0;
    overlay.classList.add('open');
  });
}

function closeModal(){
  const overlay = document.getElementById('modal-overlay');
  overlay.classList.remove('open');
  overlay.style.alignItems = '';
  overlay.style.justifyContent = '';
  overlay.style.paddingTop = '';
  overlay.style.paddingRight = '';
  overlay.style.paddingBottom = '';
  overlay.style.paddingLeft = '';
  document.body.style.overflow = '';
}

function handleOverlayClick(e){
  if(e.target===document.getElementById('modal-overlay')){
    closeModal();
  }
}

function switchMTab(tab,btn){
  document.querySelectorAll('.mtab,.mtab-content').forEach(el=>el.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('mtab-'+tab).classList.add('active');

  const modal=document.getElementById('modal');
  const tabsTop=document.querySelector('.modal-tabs')?.offsetTop || 0;
  if(modal.scrollTop > tabsTop){
    modal.scrollTo({top:tabsTop-6,behavior:'smooth'});
  }
}

document.addEventListener('keydown',function(e){
  if(e.key === 'Escape'){
    closeModal();
  }
});

window.runTest=runTest;
window.filterCat=filterCat;
window.openModal=openModal;
window.closeModal=closeModal;
window.handleOverlayClick=handleOverlayClick;
window.switchMTab=switchMTab;

renderCards('all');
</script>
