<script>
(function () {
  var ROOT = document.getElementById("tnhCoachIA");
  var AI_ENDPOINT = "https://tnhcoach.stagiaire94260.workers.dev";
  var EXPECTED_DAYS = ["Lundi","Mardi","Mercredi","Jeudi","Vendredi","Samedi","Dimanche"];
  var STORAGE_KEY = "tnh_profile_v2";
  var currentPlan = null;
  var currentWarnings = [];

  function $(id){ return ROOT ? ROOT.querySelector("#"+id) : document.getElementById(id); }
  function getValue(id){ var e=$(id); return e?e.value:""; }
  function setValue(id,v){ var e=$(id); if(e)e.value=v; }
  function setHTML(id,h){ var e=$(id); if(e)e.innerHTML=h; }

  /* ── localStorage ── */
  var _st = null;
  function saveProfile(){
    try{
      var d={
        kcal:getValue("kcal"), weightKg:getValue("weightKg"),
        dislikes:getValue("dislikes"), fridge:getValue("fridge"),
        c_veggie:!!($("c_veggie")&&$("c_veggie").checked),
        c_gluten:!!($("c_gluten")&&$("c_gluten").checked),
        c_nopork:!!($("c_nopork")&&$("c_nopork").checked),
        c_lactose:!!($("c_lactose")&&$("c_lactose").checked),
        ts:Date.now()
      };
      localStorage.setItem(STORAGE_KEY,JSON.stringify(d));
      setSaveBadge(true,d.ts);
    }catch(e){}
  }
  function debouncedSave(){ clearTimeout(_st); _st=setTimeout(saveProfile,600); }
  function loadProfile(){
    try{
      var raw=localStorage.getItem(STORAGE_KEY); if(!raw)return;
      var d=JSON.parse(raw);
      if(d.kcal)     setValue("kcal",d.kcal);
      if(d.weightKg) setValue("weightKg",d.weightKg);
      if(d.dislikes!==undefined) setValue("dislikes",d.dislikes);
      if(d.fridge!==undefined)   setValue("fridge",d.fridge);
      ["c_veggie","c_gluten","c_nopork","c_lactose"].forEach(function(id){
        var el=$(id); if(el&&d[id]!==undefined)el.checked=!!d[id];
      });
      setSaveBadge(true,d.ts);
    }catch(e){}
  }
  function setSaveBadge(saved,ts){
    var b=$("saveBadge"),l=$("saveLabel"); if(!b||!l)return;
    if(saved){
      b.classList.add("saved");
      var t=ts?new Date(ts).toLocaleTimeString("fr-FR",{hour:"2-digit",minute:"2-digit"}):"";
      l.textContent=t?"Profil sauvegardé à "+t:"Profil sauvegardé";
    }else{ b.classList.remove("saved"); l.textContent="Profil non sauvegardé"; }
  }

  /* ── Skeleton ── */
  function showSkeletonTabs(){
    var tabs=$("tabs"); if(!tabs)return;
    tabs.innerHTML=["Lun","Mar","Mer","Jeu","Ven","Sam","Dim"].map(function(d,i){
      return'<button type="button" class="tTab'+(i===0?" active":"")+'">'+d+'</button>';
    }).join("");
  }
  function showSkeletonDay(){
    var out=$("out"); if(!out)return;
    out.style.display="block";
    out.innerHTML='<div class="skelCard">'
      +'<div class="skelHead"><div class="skel skelTitle"></div>'
      +'<div class="skelBadges"><div class="skel skelBadge"></div><div class="skel skelBadge"></div></div></div>'
      +[0,1,2,3].map(function(){
        return'<div class="skelMeal"><div class="skel skelMealKind"></div>'
          +'<div class="skel skelMealTitle"></div>'
          +'<div class="skelMealMeta"><span class="skel"></span><span class="skel"></span></div></div>';
      }).join("")+'</div>';
  }

  /* ── Toast ── */
  function showToast(msg,dur){
    var t=$("tnh_toast")||document.getElementById("tnh_toast"); if(!t)return;
    t.textContent=msg; t.classList.add("show");
    setTimeout(function(){t.classList.remove("show");},dur||2500);
  }

  /* ── Fetch robuste ── */
  function sleep(ms){return new Promise(function(r){setTimeout(r,ms);});}
  async function fetchWithTimeout(url,opts,ms){
    ms=ms||28000;
    var ctrl=new AbortController();
    var timer=setTimeout(function(){ctrl.abort();},ms);
    try{return await fetch(url,Object.assign({},opts,{signal:ctrl.signal}));}
    finally{clearTimeout(timer);}
  }
  async function fetchWithRetry(url,opts,retries,ms){
    retries=retries||2; ms=ms||28000; var last;
    for(var i=0;i<=retries;i++){
      try{
        if(i>0){showToast("⟳ Tentative "+(i+1)+"/"+(retries+1)+"…"); await sleep(i*2000);}
        return await fetchWithTimeout(url,opts,ms);
      }catch(e){
        last=e;
        var ab=e&&e.name==="AbortError";
        var ne=e&&(e.name==="TypeError"||e.name==="NetworkError");
        if(!ab&&!ne)throw e;
        if(i===retries)break;
      }
    }
    throw new Error("Impossible de joindre le serveur après "+(retries+1)+" tentatives.");
  }

  /* ── Helpers ── */
  function normalize(s){return(s||"").toString().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/['']/g,"'").replace(/\s+/g," ").trim();}
  function sanitize(s,n){n=n||900;return(s||"").toString().replace(/['']/g,"'").replace(/[^\S\r\n]+/g," ").trim().slice(0,n);}
  function fixTypos(t){t=t||"";t=t.replace(/^oeufs?$/i,"œufs");t=t.replace(/^oeuf$/i,"œuf");t=t.replace(/^attieke$/i,"attiéké");t=t.replace(/^pates$/i,"pâtes");t=t.replace(/^boulgur$/i,"boulgour");return t;}
  function parseFoodList(input){
    var s=sanitize(input,1800);
    var raw=s.replace(/[\n\r\t]+/g,",").replace(/[|;/]+/g,",").split(",").map(function(x){return x.trim();}).filter(Boolean);
    var cleaned=raw.map(function(item){
      var t=item.replace(/\([^)]*\)/g," ").replace(/\b\d+([.,]\d+)?\b/g," ").replace(/\b(g|gr|kg|ml|cl|l)\b/gi," ").replace(/\s{2,}/g," ").trim();
      return fixTypos(t).trim();
    }).filter(Boolean);
    var seen=new Set(),out=[];
    cleaned.forEach(function(x){var k=normalize(x);if(!seen.has(k)){seen.add(k);out.push(x);}});
    return out;
  }
  function getWeight(){var n=parseFloat(String(getValue("weightKg")||"").replace(",","."));return isFinite(n)&&n>0?n:0;}
  function getProtein(){var w=getWeight();return w?Math.round(w*2):0;}
  function updateProtHint(){var e=$("protHint");if(e){var p=getProtein();e.textContent=p?p+" g prot/j":"0 g prot/j";}}

  /* ── Payload ── */
  function buildPayload(){
    var noLact=!!($("c_lactose")&&$("c_lactose").checked);
    var dlRaw=getValue("dislikes")||"";
    var instrText=buildPreciseInstruction();
    return{user_context:{
      kcal:parseInt(getValue("kcal")||"0",10)||0,
      protein_target_g:getProtein(),
      fridge_items:parseFoodList(getValue("fridge")||""),
      dislikes:parseFoodList(dlRaw),
      instruction:instrText,
      wants_restaurant: adjState.adjType==="restaurant" || /restaurant/i.test(instrText),
      veggie:!!($("c_veggie")&&$("c_veggie").checked),
      gluten_free:!!($("c_gluten")&&$("c_gluten").checked),
      no_pork:!!($("c_nopork")&&$("c_nopork").checked),
      no_lactose:noLact||/lactose|laitage/i.test(dlRaw),
      fast:!!($("c_fast")&&$("c_fast").checked),
      adj_day:  adjState.day     || "",
      adj_meal: adjState.meal    || "",
      adj_type: adjState.adjType || ""
    }};
  }

  async function fetchPlan(){
    var p=buildPayload();
    if(!p.user_context.kcal)       throw new Error("Ajoute le besoin calorique.");
    if(!getWeight())               throw new Error("Ajoute un poids valide.");
    if(!p.user_context.protein_target_g) throw new Error("Quota protéines invalide.");
    if(!p.user_context.fridge_items.length) throw new Error("Décris ce que tu as dans ton frigo.");
    var r=await fetchWithRetry(AI_ENDPOINT,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(p)},2,28000);
    var data; try{data=await r.json();}catch(e){throw new Error("Réponse serveur illisible.");}
    if(!r.ok){var det="";if(Array.isArray(data&&data.details))det="\n"+data.details.join("\n");else if(data&&data.details)det="\n"+data.details;throw new Error((data&&data.error?data.error:"Erreur")+det);}
    currentWarnings=Array.isArray(data&&data.warnings)?data.warnings:[];
    return data.plan;
  }

  /* ── Validation ── */
  function validatePlan(plan){
    if(!plan||!Array.isArray(plan.days))return "Plan invalide.";
    if(plan.days.length!==7)return "Le plan doit contenir 7 jours.";
    var names=plan.days.map(function(d){return(d&&d.day?d.day:"").trim();});
    for(var i=0;i<EXPECTED_DAYS.length;i++){if(names.indexOf(EXPECTED_DAYS[i])===-1)return "Jour manquant : "+EXPECTED_DAYS[i];}
    for(var j=0;j<plan.days.length;j++){var day=plan.days[j];if(!Array.isArray(day.meals)||day.meals.length!==4)return 'Jour "'+day.day+'" doit avoir 4 repas.';}
    return null;
  }
  function sortDays(plan){
    plan.days=EXPECTED_DAYS.map(function(n){return plan.days.find(function(d){return(d&&d.day?d.day:"").trim()===n;});}).filter(Boolean);
    return plan;
  }

  /* ── Render ── */
  function renderTabs(plan){
    var tabs=$("tabs"); if(!tabs)return;
    tabs.innerHTML="";
    plan.days.forEach(function(d,i){
      var b=document.createElement("button");
      b.type="button"; b.className="tTab"+(i===0?" active":""); b.textContent=d.day;
      b.addEventListener("click",function(){
        Array.prototype.forEach.call(tabs.children,function(x){x.classList.remove("active");});
        b.classList.add("active"); renderDay(plan,i);
      });
      tabs.appendChild(b);
    });
  }

  function renderDay(plan,idx){
    var out=$("out"); if(!out)return;
    var d=plan.days[idx];
    out.innerHTML='<div class="tDayCard" data-day="'+d.day+'">'
      +'<div class="tDayHead">'
      +'<div class="tDayName">'+d.day+'</div>'
      +'<div class="tTotals">'
      +'<span>'+Math.round(Number(d.totals.kcal||0))+' kcal</span>'
      +'<span>P '+Math.round(Number(d.totals.protein_g||0))+'g</span>'
      +'<span>G '+Math.round(Number(d.totals.carbs_g||0))+'g</span>'
      +'<span>L '+Math.round(Number(d.totals.fat_g||0))+'g</span>'
      +'</div></div>'
      +(d.meals||[]).map(function(m){
        return '<details class="tMeal">'
          +'<summary>'
          +'<div><div class="tMealKind">'+m.name+'</div><div class="tMealTitle">'+m.title+'</div></div>'
          +'<div class="tMealMeta">'
          +'<span>'+Math.round(Number(m.time_min||0))+' min</span>'
          +'<span>'+Math.round(Number((m.macros&&m.macros.kcal)||0))+' kcal</span>'
          +'</div></summary>'
          +'<div class="tMealBody">'
          +'<div class="tMealMacros">'
          +'<span>P '+Math.round(Number((m.macros&&m.macros.protein_g)||0))+'g</span>'
          +'<span>G '+Math.round(Number((m.macros&&m.macros.carbs_g)||0))+'g</span>'
          +'<span>L '+Math.round(Number((m.macros&&m.macros.fat_g)||0))+'g</span>'
          +'</div>'
          +'<div class="tCols2">'
          +'<div><div class="tColTitle">Quantités</div>'
          +'<ul class="tList">'+(m.ingredients||[]).map(function(x){return'<li>'+x+'</li>';}).join('')+'</ul></div>'
          +'<div><div class="tColTitle">Étapes express</div>'
          +'<ul class="tList">'+(m.steps||[]).map(function(x){return'<li>'+x+'</li>';}).join('')+'</ul></div>'
          +'</div></div></details>';
      }).join("")
      +'</div>';
  }

  function matchesMeal(meal,q){
    if(!q)return true;
    var hay=normalize([meal.name,meal.title,(meal.ingredients||[]).join(" "),(meal.steps||[]).join(" ")].join(" "));
    return hay.indexOf(normalize(q))!==-1;
  }

  function renderWeek(plan,query){
    var wrap=$("tnh_week_v5"); if(!wrap)return;
    wrap.innerHTML="";
    plan.days.forEach(function(d,di){
      var meals=(d.meals||[]).filter(function(m){return matchesMeal(m,query);});
