  /* ═══════════════════════════════════════════════
     AJUSTEMENTS PRÉCIS
  ═══════════════════════════════════════════════ */

  // État interne des sélecteurs
  var adjState = { day: "", meal: "", preset: "", adjType: "", label: "", free: "" };

  // Position fixe des repas : 0=Petit-déj, 1=Déjeuner, 2=Collation, 3=Dîner
  // On utilise l'index plutôt que le nom pour éviter les faux-positifs
  // ("dejeuner" est sous-chaîne de "petit-dejeuner" → bug)
  var MEAL_INDEX_MAP = {
    "Petit-déjeuner": 0,
    "Déjeuner":       1,
    "Collation":      2,
    "Dîner":          3
  };

  function getMealIndex(adjMeal){
    if(!adjMeal) return -1;
    return (typeof MEAL_INDEX_MAP[adjMeal] !== "undefined") ? MEAL_INDEX_MAP[adjMeal] : -1;
  }

  /* Merge : greffe le nouveau plan sur l'ancien selon day/meal (par index) */
  function mergePlans(oldPlan, newPlan, targetDay, targetMeal){
    var merged = JSON.parse(JSON.stringify(oldPlan)); // deep clone
    var mealIdx = getMealIndex(targetMeal); // -1 = tous les repas

    newPlan.days.forEach(function(newDay){
      if(targetDay && newDay.day !== targetDay) return; // pas ce jour → ignore
      var oldDay = merged.days.find(function(d){ return d.day === newDay.day; });
      if(!oldDay) return;

      if(mealIdx === -1){
        // Pas de repas ciblé → remplacer tout le jour
        oldDay.meals  = newDay.meals;
        oldDay.totals = newDay.totals;
      } else {
        // Repas ciblé par position → remplacer UNIQUEMENT cet index
        var newMeal = newDay.meals[mealIdx];
        if(!newMeal){
          // Fallback : chercher dans le nouveau jour par position approchée
          newMeal = newDay.meals[Math.min(mealIdx, newDay.meals.length - 1)];
        }
        if(newMeal && oldDay.meals[mealIdx]){
          oldDay.meals[mealIdx] = newMeal;
        }

        // Recalculer les totaux du jour
        var totals = { kcal:0, protein_g:0, carbs_g:0, fat_g:0 };
        oldDay.meals.forEach(function(m){
          var mac = m.macros || {};
          totals.kcal      += Number(mac.kcal      || 0);
          totals.protein_g += Number(mac.protein_g || 0);
          totals.carbs_g   += Number(mac.carbs_g   || 0);
          totals.fat_g     += Number(mac.fat_g     || 0);
        });
        ["kcal","protein_g","carbs_g","fat_g"].forEach(function(k){
          totals[k] = Math.round(totals[k]);
        });
        oldDay.totals = totals;
      }
    });

    merged.meta = oldPlan.meta || newPlan.meta;
    return merged;
  }

  function buildPreciseInstruction(){
    var day    = adjState.day;
    var meal   = adjState.meal;
    var preset = adjState.preset;
    var free   = adjState.free.trim();
    var parts  = [];

    // Scope très explicite pour l'IA
    if(day && meal){
      parts.push("CONSIGNE STRICTE : modifie UNIQUEMENT le repas '"+meal+"' du "+day+".");
      parts.push("Tous les autres jours et tous les autres repas du "+day+" restent IDENTIQUES.");
    } else if(day){
      parts.push("CONSIGNE STRICTE : modifie UNIQUEMENT les repas du "+day+".");
      parts.push("Tous les autres jours restent IDENTIQUES.");
    } else if(meal){
      parts.push("CONSIGNE STRICTE : modifie UNIQUEMENT les '"+meal+"' de chaque jour.");
      parts.push("Tous les autres types de repas (déjeuner, dîner, etc.) restent IDENTIQUES.");
    }

    if(preset) parts.push("Contrainte : " + preset + ".");
    if(free)   parts.push(free);

    return parts.join(" ");
  }

