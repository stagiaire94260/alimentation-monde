    Array.prototype.forEach.call(ROOT.querySelectorAll("#chipDays .adjChip"), function(btn){
      btn.addEventListener("click", function(){
        Array.prototype.forEach.call(ROOT.querySelectorAll("#chipDays .adjChip"), function(b){ b.classList.remove("adjChipActive"); });
        btn.classList.add("adjChipActive");
        adjState.day = btn.getAttribute("data-day") || "";
        updateAdjPreview();
      });
    });

    /* ── CHIPS REPAS ── */
    Array.prototype.forEach.call(ROOT.querySelectorAll("#chipMeals .adjChip"), function(btn){
      btn.addEventListener("click", function(){
        Array.prototype.forEach.call(ROOT.querySelectorAll("#chipMeals .adjChip"), function(b){ b.classList.remove("adjChipActive"); });
        btn.classList.add("adjChipActive");
        adjState.meal = btn.getAttribute("data-meal") || "";
        updateAdjPreview();
      });
    });

    /* ── PRESETS CHANGEMENT ── */
    Array.prototype.forEach.call(ROOT.querySelectorAll(".tPreset"), function(btn){
      btn.addEventListener("click", function(){
        var wasActive = btn.classList.contains("adjChipActive");
        Array.prototype.forEach.call(ROOT.querySelectorAll(".tPreset"), function(b){ b.classList.remove("adjChipActive"); });
        if(!wasActive){
          btn.classList.add("adjChipActive");
          adjState.adjType = btn.getAttribute("data-adj-type") || "";
          adjState.label   = btn.getAttribute("data-label")   || "";
          adjState.preset  = adjState.label; // rétrocompat instruction texte
        } else {
          adjState.adjType = "";
          adjState.label   = "";
          adjState.preset  = "";
        }
        updateAdjPreview();
      });
    });

    /* ── INSTRUCTION LIBRE ── */
    var instrEl = $("instruction");
    if(instrEl){
      instrEl.addEventListener("input", function(){
        adjState.free = instrEl.value || "";
        // Désactiver presets si texte libre
        if(adjState.free.trim()){
          Array.prototype.forEach.call(ROOT.querySelectorAll(".tPreset"), function(b){ b.classList.remove("adjChipActive"); });
          adjState.preset  = "";
          adjState.adjType = "";
          adjState.label   = "";
        }
        updateAdjPreview();
      });
    }
    var wk=$("weightKg");
    if(wk){wk.addEventListener("input",function(){updateProtHint();debouncedSave();});wk.addEventListener("change",function(){updateProtHint();debouncedSave();});}
    var sr=$("tnh_search_v5"),sc=$("tnh_search_clear_v5"),vd=$("tnh_view_day_v5"),vw=$("tnh_view_week_v5"),fr=$("fridge");
    if(sr){sr.addEventListener("input",function(){var q=(getValue("tnh_search_v5")||"").trim();if(currentPlan){renderWeek(currentPlan,q);setView("week");}});}
    if(sc){sc.addEventListener("click",function(){setValue("tnh_search_v5","");if(currentPlan){renderWeek(currentPlan,"");setView("week");}});}
    if(vd)vd.addEventListener("click",function(){setView("day");});
    if(vw)vw.addEventListener("click",function(){setView("week");});
    if(fr){fr.addEventListener("blur",function(){var n=parseFoodList(fr.value).join(", ");if(n)fr.value=n;debouncedSave();});}
    ["kcal","dislikes"].forEach(function(id){var e=$(id);if(e)e.addEventListener("input",debouncedSave);});
    ["c_veggie","c_gluten","c_nopork","c_lactose"].forEach(function(id){var e=$(id);if(e)e.addEventListener("change",debouncedSave);});
  }

  function init(){ loadProfile(); updateProtHint(); bind(); }
  if(document.readyState==="loading"){ document.addEventListener("DOMContentLoaded",init); } else { init(); }
})();
</script>

</div><!-- /tApp -->
