  /* ═══════════════════════════════════════════════
     APPLY ADJUST — merge intelligent
  ═══════════════════════════════════════════════ */
  async function applyAdjustFlow(){
    var targetDay  = adjState.day;
    var targetMeal = adjState.meal;
    var hasScope   = targetDay || targetMeal;
    var instr      = buildPreciseInstruction();

    // Si pas de plan existant ou aucun scope → génération complète
    if(!currentPlan || !hasScope){
      await generateFlow();
      return;
    }

    // Scope précis + plan existant → merge
    updateProtHint();

    // Feedback visuel ciblé : skeleton uniquement sur le jour concerné
    var btn = $("btnAdjust");
    if(btn){ btn.disabled = true; btn.textContent = "Application…"; }

    // Highlight visuel du jour concerné dans les tabs
    var tabs = $("tabs");
    if(tabs && targetDay){
      Array.prototype.forEach.call(tabs.children, function(t){
        t.style.opacity = (t.textContent === targetDay) ? "1" : "0.35";
      });
    }

    try{
      // Générer un nouveau plan complet avec l'instruction précise
      var newPlan = await fetchPlan();
      var err = validatePlan(newPlan);
      if(err) throw new Error(err);
      sortDays(newPlan);

      // Merger : ne garder que la partie ciblée
      var mergedPlan = mergePlans(currentPlan, newPlan, targetDay || null, targetMeal || null);
      currentPlan = mergedPlan;

      // Trouver le jour à afficher
      var dayIndex = 0;
      if(targetDay){
        var idx = currentPlan.days.findIndex(function(d){ return d.day === targetDay; });
        if(idx !== -1) dayIndex = idx;
      }

      renderTabs(currentPlan);
      renderDay(currentPlan, dayIndex);
      renderWeek(currentPlan, "");
      renderShopping(currentPlan);

      // Résumé du changement
      var scopeMsg = targetDay && targetMeal ? targetMeal + " du " + targetDay
        : targetDay  ? "Tous les repas de " + targetDay
        : "Tous les " + targetMeal + "s";
      showToast("✓ " + scopeMsg + " mis à jour", 2800);

      // Naviguer au jour modifié
      if(tabs && targetDay){
        Array.prototype.forEach.call(tabs.children, function(t){
          t.style.opacity = "";
          if(t.textContent === targetDay){ t.click(); }
        });
      }

      var op = $("outputPanel");
      if(op) op.scrollIntoView({behavior:"smooth", block:"start"});

    }catch(e){
      console.error(e);
      // Restaurer tabs
      if(tabs){ Array.prototype.forEach.call(tabs.children, function(t){ t.style.opacity = ""; }); }
      alert(String(e && e.message ? e.message : "Ajustement échoué."));
    }finally{
      if(btn){
        btn.disabled = false;
        var sc = adjState.day && adjState.meal ? adjState.meal + " · " + adjState.day
          : adjState.day  ? adjState.day
          : adjState.meal ? "Tous les " + adjState.meal + "s"
          : "Appliquer";
        btn.textContent = "Appliquer — " + sc;
      }
    }
  }

