<script>
const COMP_URL = "https://www.thenarcissichealth.fr/school/course/mybetterself/lecture/9442303";

// ─── Helpers ───────────────────────────────────────────────────────────────
function buildQuiz(containerID, questions, onFinish) {
  var container = document.getElementById(containerID + "steps");
  var prevBtn   = document.getElementById(containerID + "prev");
  var nextBtn   = document.getElementById(containerID + "next");
  var errBox    = document.getElementById(containerID + "error");
  var bar       = document.getElementById(containerID + "bar");
  var stepTxt   = document.getElementById(containerID + "step");
  var secTxt    = document.getElementById(containerID + "section");

  var answers = {}, cur = 1, tot = questions.length;

  // Build steps HTML
  container.innerHTML = questions.map(function(q) {
    var opts = q.opts.map(function(o) {
      return `<button type="button" class="q-opt" data-name="${q.name}" data-value="${o.v}">${o.l}</button>`;
    }).join("");
    var hidden = q.step > 1 ? " hidden" : "";
    var badge  = q.section || ("Question " + q.step + "/" + tot);
    return `<div class="q-step" data-step="${q.step}"${hidden}><div class="q-card"><div class="q-badge">${badge}</div><div class="q-title">${q.q}</div><div class="q-opts">${opts}</div></div></div>`;
  }).join("");

  function restoreSel() {
    container.querySelectorAll(".q-opt").forEach(function(b) {
      b.classList.toggle("sel", answers[b.dataset.name] === b.dataset.value);
    });
  }

  container.addEventListener("click", function(e) {
    var b = e.target.closest(".q-opt");
    if (!b) return;
    answers[b.dataset.name] = b.dataset.value;
    errBox.textContent = "";
    restoreSel();
  });

  function update() {
    container.querySelectorAll(".q-step").forEach(function(s) {
      s.hidden = parseInt(s.dataset.step) !== cur;
    });
    var q = questions[cur - 1];
    stepTxt.textContent = "Question " + cur + " sur " + tot;
    if (secTxt) secTxt.textContent = q.section || "";
    bar.style.width = Math.round(((cur - 1) / tot) * 100) + "%";
    prevBtn.disabled = cur === 1;
    prevBtn.style.opacity = cur === 1 ? ".5" : "1";
    nextBtn.textContent = cur === tot ? "Voir mes r\u00e9sultats" : "Suivant";
    restoreSel();
  }

  function answered() {
    return !!answers[questions[cur - 1].name];
  }

  nextBtn.addEventListener("click", function() {
    errBox.textContent = "";
    if (!answered()) { errBox.textContent = "Choisis une r\u00e9ponse pour continuer."; return; }
    if (cur < tot) { cur++; update(); return; }
    onFinish(answers);
  });

  prevBtn.addEventListener("click", function() {
    errBox.textContent = "";
    if (cur > 1) { cur--; update(); }
  });

  update();
}

function makeAcc(items, bindClick) {
  var html = items.map(function(item) {
    return `<div class="acc-item ${item.open ? "open" : ""}">
      <button class="acc-btn" type="button">
        <span class="acc-btn-title">${item.title}</span>
        <span class="acc-arrow">+</span>
      </button>
      <div class="acc-content">${item.body}</div>
    </div>`;
  }).join("");
  if (bindClick) {
    setTimeout(function() {
      document.querySelectorAll(".acc-btn").forEach(function(b) {
        if (!b._bound) { b._bound = true; b.addEventListener("click", function() { this.parentElement.classList.toggle("open"); }); }
      });
    }, 50);
  }
  return html;
}

function compLink(comps) {
  if (!comps || !comps.length) return "";
  var tags = comps.map(function(c) { return `<span class="qr-ctag">${c}</span>`; }).join("");
  return `<div class="acc-block">
    <div class="acc-label">Compl\u00e9ments qui peuvent aider</div>
    <div class="qr-comps">${tags}</div>
    <a href="${COMP_URL}" target="_blank" style="display:inline-block;margin-top:10px;font-size:12px;font-weight:800;color:var(--red);text-decoration:none;border:1px solid rgba(169,27,24,.2);border-radius:999px;padding:5px 13px;background:rgba(169,27,24,.06);">Voir le guide compl\u00e9ments \u2192</a>
  </div>`;
}

function showResults(containerID, badge, title, blocks, extraItems) {
  var el = document.getElementById(containerID + "results");
  var items = blocks.map(function(b, i) {
    return { title: b.label, body: `<div class="acc-block"><p class="acc-text">${b.text}</p></div>`, open: i === 0 };
  });
  if (extraItems) items = items.concat(extraItems);
  items.push({
    title: "Important",
    open: false,
    body: `<div class="acc-note"><strong>Important :</strong> ce quiz ne remplace ni un avis m\u00e9dical ni un diagnostic. Il est l\u00e0 pour t\u2019aider \u00e0 rep\u00e9rer certains signaux et ouvrir des pistes de r\u00e9flexion. Si tu te reconnais fortement dans plusieurs signes et que \u00e7a dure, consulter un m\u00e9decin est la bonne d\u00e9marche.</div>`
  });
  el.innerHTML = `<div class="qr-wrap">
    <div class="qr-head"><div class="qr-badge">${badge}</div><div class="qr-title">${title}</div></div>
    <div class="qr-body">${makeAcc(items, true)}</div>
  </div>`;
  el.classList.add("show");
  setTimeout(function() { el.scrollIntoView({ behavior: "smooth", block: "start" }); }, 80);
}

