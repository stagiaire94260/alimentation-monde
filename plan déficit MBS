function getNutritionProfile(need, intake) {
  const delta = intake - need;

  if (delta <= -701) return { profile: "under_severe", family: "under" };
  if (delta <= -351) return { profile: "under_moderate", family: "under" };
  if (delta <= -201) return { profile: "under_light", family: "under" };

  if (delta < 0)     return { profile: "around_low", family: "around" };
  if (delta <= 200)  return { profile: "around_high", family: "around" };

  if (delta <= 350)  return { profile: "over_light", family: "over" };
  if (delta <= 700)  return { profile: "over_moderate", family: "over" };
  return { profile: "over_severe", family: "over" };
}

  function resolveTemplateValue(value, need, intake) {
    if (typeof value === "number") return roundTo50(value);

    const clean = String(value).replace(/\s+/g, "");

    if (/^need([+-]\d+)?$/i.test(clean)) {
      const match = clean.match(/^need([+-]\d+)?$/i);
      const offset = match && match[1] ? parseInt(match[1], 10) : 0;
      return roundTo50(need + offset);
    }

    if (/^intake([+-]\d+)?$/i.test(clean)) {
      const match = clean.match(/^intake([+-]\d+)?$/i);
      const offset = match && match[1] ? parseInt(match[1], 10) : 0;
      return roundTo50(intake + offset);
    }

    const numeric = parseFloat(clean);
    if (Number.isFinite(numeric)) return roundTo50(numeric);

    return roundTo50(need);
  }

  function sanitizeWeeklyCalories(arr, need, intake, profile) {
    const out = arr.map(v => resolveTemplateValue(v, need, intake));

    if (profile === "under_severe") {
      for (let i = 0; i < out.length; i++) {
        out[i] = Math.max(out[i], intake + 100);
      }
    }

    if (profile === "over_severe") {
      for (let i = 1; i < out.length; i++) {
        const maxDrop = 250;
        if (out[i] < out[i - 1] - maxDrop) out[i] = out[i - 1] - maxDrop;
      }
    }

    return out.map(roundTo50);
  }

