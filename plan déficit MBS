  function getDaySchedule() {
    const wake = parseTimeToMinutes(document.getElementById("wakeTime").value);
    const trainingStartRaw = parseTimeToMinutes(document.getElementById("trainingTime").value);
    const lunchRaw = parseTimeToMinutes(document.getElementById("lunchTime").value);
    const dinnerRaw = parseTimeToMinutes(document.getElementById("dinnerTime").value);
    const sleepRaw = parseTimeToMinutes(document.getElementById("sleepTime").value);

    if ([wake, trainingStartRaw, lunchRaw, dinnerRaw, sleepRaw].some(v => v === null)) {
      return { ok: false, error: "Remplis correctement tous tes horaires." };
    }

    let trainingStart = trainingStartRaw;
    let lunch = lunchRaw;
    let dinner = dinnerRaw;
    let sleep = sleepRaw;

    if (sleep <= wake) sleep += 1440;
    if (dinner <= wake) dinner += 1440;
    if (lunch <= wake) lunch += 1440;
    if (trainingStart <= wake) trainingStart += 1440;

    if (trainingStart <= wake) return { ok: false, error: "Ton training doit être après ton réveil." };
    if (lunch <= wake) return { ok: false, error: "Ton déjeuner doit être après ton réveil." };
    if (dinner <= lunch) return { ok: false, error: "Ton dîner doit être après ton déjeuner." };
    if (sleep <= dinner) return { ok: false, error: "Ton coucher doit être après ton dîner." };

    return { ok: true, wake, trainingStart, trainingEnd: trainingStart + 60, lunch, dinner, sleep };
  }

  function buildTimingRows() {
    const schedule = getDaySchedule();
    if (!schedule.ok) return { ok: false, message: schedule.error, alert: "", rows: [] };

    const { wake, trainingStart, trainingEnd, lunch, dinner, sleep } = schedule;
    const rows = [];
    const alerts = [];

    function addRow(mins, title, food, details) {
      if (mins == null) return;
      rows.push({ hour: formatMinutes(mins), title, food: food || "", details: details || "" });
    }

    const diffWakeToTraining = trainingStart - wake;
    const lunchTooCloseToTraining = lunch >= (trainingStart - 45) && lunch <= (trainingEnd + 30);
    const dinnerTooCloseToTraining = dinner >= (trainingStart - 45) && dinner <= (trainingEnd + 30);
    const isVeryLateTraining = trainingStart >= 21 * 60;
    const isMorningTraining = trainingStart < 12 * 60;
    const isAfternoonTraining = trainingStart >= 12 * 60 && trainingStart < 20 * 60;
    const isEveningTraining = trainingStart >= 20 * 60;

    addRow(wake, "🌞 Réveil", "Grand verre d'eau.", "On réveille doucement ton corps avant d'envoyer la journée.");

    if (isMorningTraining) {
      if (diffWakeToTraining < 75) {
        const preTraining = trainingStart - 45;
        if (preTraining <= wake) return { ok: false, message: "Tes horaires sont trop serrés. Avance ton réveil ou décale ton training.", alert: "", rows: [] };
        addRow(preTraining, "🍌 Pré-training", "Petit apport digeste obligatoire avant la séance.", "Ici on ne part pas à vide.<br><em>Ex : banane, compote, yaourt, tranche de pain + miel.</em>");
        addRow(trainingStart, "🏋️ Training", "", "");
        if ((lunch - trainingEnd) < 120) {
          addRow(trainingEnd + 15, "🥛 Collation protéinée", "Protéines juste après la séance.", "Comme le déjeuner arrive vite, on met juste une collation protéinée.");
        } else {
          addRow(trainingEnd + 20, "🥑 Petit-déjeuner", "Protéines + glucides + bons lipides.", "Le déjeuner est encore loin, tu peux faire un vrai petit-déj après la séance.");
        }
        const lunchAfterTraining = Math.max(lunch, trainingEnd + 60);
        if (lunchAfterTraining !== lunch) alerts.push("Ton déjeuner a été légèrement décalé après la séance.");
        addRow(lunchAfterTraining, "🍽️ Déjeuner", "Glucides + protéines + légumes.", "Un vrai repas structuré après ta séance.");
      } else {
        const breakfastBefore = (trainingStart - (wake + 30)) >= 60 ? wake + 30 : null;
        let preTraining = null;
        if ((trainingStart - wake) > 90) {
          const candidate = trainingStart - 45;
          if (!breakfastBefore || (candidate - breakfastBefore) >= 60) preTraining = candidate;
        }
        if (breakfastBefore) addRow(breakfastBefore, "🥑 Petit-déjeuner", "Protéines + glucides + bons lipides.", "Ton training est assez loin du réveil, tu peux faire un vrai petit-déj avant.");
        if (preTraining) addRow(preTraining, "🍌 Pré-training", "Petit apport digeste avant la séance.", "Tu l'ajoutes si ta séance est éloignée du petit-déj.");
        addRow(trainingStart, "🏋️ Training", "", "");
        if ((lunch - trainingEnd) > 90) addRow(trainingEnd + 20, "🥛 Collation protéinée", "Shaker protéiné ou collation protéinée.", "Le déjeuner est encore loin, on ajoute une collation protéinée pour la récup.");
        const lunchAfterTraining = lunchTooCloseToTraining ? trainingEnd + 45 : lunch;
        if (lunchTooCloseToTraining) alerts.push("Ton déjeuner était trop proche de la séance, il a été replacé après.");
        addRow(lunchAfterTraining, "🍽️ Déjeuner", "Glucides + protéines + légumes.", "Un vrai repas structuré pour tenir ton objectif calorique.");
      }
    } else if (isAfternoonTraining) {
      addRow(wake + 30, "🥑 Petit-déjeuner", "Protéines + glucides + bons lipides.", "Un vrai petit-déj pour lancer la journée.");
      if (lunchTooCloseToTraining) {
        const preTraining = trainingStart - 45;
        if (preTraining <= wake) return { ok: false, message: "Déjeuner trop proche de la séance, impossible de placer un pré-training cohérent.", alert: "", rows: [] };
        addRow(preTraining, "🍌 Pré-training", "Petit apport digeste avant la séance.", "Le déjeuner était trop proche, on le remplace par un pré-training.");
        addRow(trainingStart, "🏋️ Training", "", "");
        addRow(trainingEnd + 45, "🍽️ Déjeuner", "Glucides + protéines + légumes.", "Ton vrai déjeuner passe après la séance.");
        alerts.push("Le déjeuner a été déplacé après la séance car il tombait trop près du training.");
      } else {
        addRow(lunch, "🍽️ Déjeuner", "Glucides + protéines + légumes.", "Un vrai repas structuré avant ta séance.");
        if ((trainingStart - lunch) >= 180) {
          const preTraining = trainingStart - 45;
          if (preTraining > lunch + 75) addRow(preTraining, "🍌 Pré-training", "Petit apport digeste avant la séance.", "L'écart entre le déjeuner et la séance est long.");
        }
        addRow(trainingStart, "🏋️ Training", "", "");
      }
      const dinnerAfterTraining = dinnerTooCloseToTraining ? trainingEnd + 45 : dinner;
      if (dinnerTooCloseToTraining) alerts.push("Le dîner a été déplacé après la séance.");
      addRow(dinnerAfterTraining, "🌙 Dîner", "Repas complet.", "Ton dîner passe après la séance pour finir la journée proprement.");
    } else if (isEveningTraining) {
      addRow(wake + 30, "🥑 Petit-déjeuner", "Protéines + glucides + bons lipides.", "Un vrai petit-déj pour lancer la journée.");
      addRow(lunch, "🍽️ Déjeuner", "Glucides + protéines + légumes.", "Un vrai repas structuré pour tenir ta journée.");
      if (isVeryLateTraining) {
        const dinnerBeforeLateTraining = Math.max(lunch + 120, trainingStart - 90);
        addRow(dinnerBeforeLateTraining, "🌙 Dîner", "Repas complet avant la séance.", "Le dîner passe avant, environ 1h30 à 2h avant le training tardif.");
        addRow(trainingStart, "🏋️ Training", "", "");
        const proteinSnackLate = trainingEnd + 15;
        if (proteinSnackLate < sleep) addRow(proteinSnackLate, "🥛 Collation protéinée", "Protéines après la séance.", "Après un training tardif, on part sur une collation protéinée.");
      } else {
        if (dinnerTooCloseToTraining) {
          const preTraining = trainingStart - 45;
          if (preTraining > lunch + 90) addRow(preTraining, "🍌 Pré-training", "Petit apport digeste avant la séance.", "Le dîner était trop proche, on le remplace par un pré-training.");
          addRow(trainingStart, "🏋️ Training", "", "");
          addRow(trainingEnd + 45, "🌙 Dîner", "Repas complet.", "Ton dîner passe après la séance.");
          alerts.push("Le dîner a été déplacé après la séance.");
        } else {
          if ((trainingStart - dinner) >= 180) {
            const preTraining = trainingStart - 45;
            if (preTraining > dinner + 60) addRow(preTraining, "🍌 Pré-training", "Petit apport digeste avant la séance.", "L'écart entre le dîner et la séance est long.");
          }
          addRow(dinner, "🌙 Dîner", "Repas complet.", "Ton dîner est placé avant la séance, avec assez de marge.");
          addRow(trainingStart, "🏋️ Training", "", "");
        }
      }
    }

    if (!rows.some(r => r.title === "🌙 Dîner")) {
      addRow(dinner, "🌙 Dîner", "Repas complet.", "On termine avec un dîner structuré et rassasiant.");
    }

    const currentLunch = rows.find(r => r.title === "🍽️ Déjeuner");
    const currentDinner = rows.find(r => r.title === "🌙 Dîner");
    if (currentLunch && currentDinner) {
      const lunchMin = parseTimeToMinutes(currentLunch.hour);
      const dinnerMin = parseTimeToMinutes(currentDinner.hour);
      if ((dinnerMin - lunchMin) >= 300) {
        const snackTime = lunchMin + Math.round((dinnerMin - lunchMin) / 2);
        const alreadyHasSnack = rows.some(r => {
          const t = parseTimeToMinutes(r.hour);
          return t > lunchMin && t < dinnerMin && (r.title.includes("Collation") || r.title.includes("Pré-training"));
        });
        if (!alreadyHasSnack) addRow(snackTime, "🥛 Collation protéinée", "Shaker protéiné ou collation riche en protéines.", "L'écart entre le déjeuner et le dîner est long, on ajoute une collation.");
      }
    }

    rows.sort((a, b) => parseTimeToMinutes(a.hour) - parseTimeToMinutes(b.hour));
    return { ok: true, message: "", alert: alerts.join(" "), rows };
  }

  function fillTimingPlanner() {
    const container = document.getElementById("popupSectionContent");
    if (!container) return;
    const result = buildTimingRows();
    if (!result.ok) {
      container.innerHTML = `<div class="timingPlanner"><div class="timingPlannerItem open"><div class="timingPlannerCard" style="grid-column:1/-1;"><div class="timingPlannerTitle">⚠️ Horaires incohérents</div><div class="timingPlannerDetails" style="display:block;margin-top:10px;">${result.message}</div></div></div></div>`;
      return;
    }
    const alertBlock = result.alert ? `<div class="timingPlannerItem open"><div class="timingPlannerCard" style="grid-column:1/-1;margin-bottom:4px;"><div class="timingPlannerTitle">ℹ️ Ajustement du planning</div><div class="timingPlannerDetails" style="display:block;margin-top:10px;">${result.alert}</div></div></div>` : "";
    container.innerHTML = `
      <div class="timingPlanner">
        ${alertBlock}
        ${result.rows.map(row => `
          <div class="timingPlannerItem">
            <div class="timingPlannerHour">${row.hour}</div>
            <div class="timingPlannerCard">
              <div class="timingPlannerCardHeader">
                <div>
                  <div class="timingPlannerTitle">${row.title}</div>
                  ${row.food ? `<div class="timingPlannerFood">${row.food}</div>` : ""}
                </div>
                ${row.details ? `<div class="timingPlannerToggle">▾</div>` : ""}
              </div>
              ${row.details ? `<div class="timingPlannerDetails">${row.details}</div>` : ""}
            </div>
          </div>`).join("")}
        <p class="timingCompactNote">Ton planning s'adapte à tes horaires. Le but n'est pas d'être rigide, mais de mieux répartir tes apports autour de tes séances.</p>
      </div>`;
    document.querySelectorAll("#popupSectionContent .timingPlannerItem").forEach(item => {
      const details = item.querySelector(".timingPlannerDetails");
      const card = item.querySelector(".timingPlannerCard");
      if (!details || !card) return;
      card.onclick = () => item.classList.toggle("open");
    });
  }

