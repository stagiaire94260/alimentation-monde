    } else if (isEveningTraining) {
      addRow(wake + 30, "🥑 Petit-déjeuner", "Protéines + glucides + bons lipides.", "Un vrai petit-déj pour lancer la journée.");
      addRow(lunch, "🍽️ Déjeuner", "Glucides + protéines + légumes.", "Un vrai repas structuré pour tenir ta journée.");
      if (isVeryLateTraining) {
        const dinnerBeforeLateTraining = Math.max(lunch + 120, trainingStart - 90);
        addRow(dinnerBeforeLateTraining, "🌙 Dîner", "Repas complet avant la séance.", "Le dîner passe avant, environ 1h30 à 2h avant le training tardif.");
        addRow(trainingStart, "🏋️ Training", "", "");
        const proteinSnackLate = trainingEnd + 15;
        if (proteinSnackLate < sleep) addRow(proteinSnackLate, "🥛 Collation protéinée", "Protéines après la séance.", "Après un training tardif, on part sur une collation protéinée.");
      } else {
        if (dinnerTooCloseToTraining) {
          const preTraining = trainingStart - 45;
          if (preTraining > lunch + 90) addRow(preTraining, "🍌 Pré-training", "Petit apport digeste avant la séance.", "Le dîner était trop proche, on le remplace par un pré-training.");
          addRow(trainingStart, "🏋️ Training", "", "");
          addRow(trainingEnd + 45, "🌙 Dîner", "Repas complet.", "Ton dîner passe après la séance.");
          alerts.push("Le dîner a été déplacé après la séance.");
        } else {
          if ((trainingStart - dinner) >= 180) {
            const preTraining = trainingStart - 45;
            if (preTraining > dinner + 60) addRow(preTraining, "🍌 Pré-training", "Petit apport digeste avant la séance.", "L'écart entre le dîner et la séance est long.");
          }
          addRow(dinner, "🌙 Dîner", "Repas complet.", "Ton dîner est placé avant la séance, avec assez de marge.");
          addRow(trainingStart, "🏋️ Training", "", "");
        }
      }
    }

    if (!rows.some(r => r.title === "🌙 Dîner")) {
      addRow(dinner, "🌙 Dîner", "Repas complet.", "On termine avec un dîner structuré et rassasiant.");
    }

    const currentLunch = rows.find(r => r.title === "🍽️ Déjeuner");
    const currentDinner = rows.find(r => r.title === "🌙 Dîner");
    if (currentLunch && currentDinner) {
      const lunchMin = parseTimeToMinutes(currentLunch.hour);
      const dinnerMin = parseTimeToMinutes(currentDinner.hour);
      if ((dinnerMin - lunchMin) >= 300) {
        const snackTime = lunchMin + Math.round((dinnerMin - lunchMin) / 2);
        const alreadyHasSnack = rows.some(r => {
          const t = parseTimeToMinutes(r.hour);
          return t > lunchMin && t < dinnerMin && (r.title.includes("Collation") || r.title.includes("Pré-training"));
        });
        if (!alreadyHasSnack) addRow(snackTime, "🥛 Collation protéinée", "Shaker protéiné ou collation riche en protéines.", "L'écart entre le déjeuner et le dîner est long, on ajoute une collation.");
      }
    }

    rows.sort((a, b) => parseTimeToMinutes(a.hour) - parseTimeToMinutes(b.hour));
    return { ok: true, message: "", alert: alerts.join(" "), rows };
  }

  function fillTimingPlanner() {
    const container = document.getElementById("popupSectionContent");
    if (!container) return;
    const result = buildTimingRows();

    if (!result.ok) {
      container.innerHTML = `<div class="timingPlanner"><div class="timingPlannerItem open"><div class="timingPlannerCard" style="grid-column:1/-1;"><div class="timingPlannerTitle">⚠️ Horaires incohérents</div><div class="timingPlannerDetails" style="display:block;margin-top:10px;">${result.message}</div></div></div></div>`;
      return;
    }

    const alertBlock = result.alert ? `<div class="timingPlannerItem open"><div class="timingPlannerCard" style="grid-column:1/-1;margin-bottom:4px;"><div class="timingPlannerTitle">ℹ️ Ajustement du planning</div><div class="timingPlannerDetails" style="display:block;margin-top:10px;">${result.alert}</div></div></div>` : "";

    container.innerHTML = `
      <div class="timingPlanner">
        ${alertBlock}
        ${result.rows.map(row => `
          <div class="timingPlannerItem">
            <div class="timingPlannerHour">${row.hour}</div>
            <div class="timingPlannerCard">
              <div class="timingPlannerCardHeader">
                <div>
                  <div class="timingPlannerTitle">${row.title}</div>
                  ${row.food ? `<div class="timingPlannerFood">${row.food}</div>` : ""}
                </div>
                ${row.details ? `<div class="timingPlannerToggle">▾</div>` : ""}
              </div>
              ${row.details ? `<div class="timingPlannerDetails">${row.details}</div>` : ""}
            </div>
          </div>`).join("")}
        <p class="timingCompactNote">Ton planning s'adapte à tes horaires. Le but n'est pas d'être rigide, mais de mieux répartir tes apports autour de tes séances.</p>
      </div>`;

    document.querySelectorAll("#popupSectionContent .timingPlannerItem").forEach(item => {
      const details = item.querySelector(".timingPlannerDetails");
      const card = item.querySelector(".timingPlannerCard");
      if (!details || !card) return;
      card.onclick = () => item.classList.toggle("open");
    });
  }

  function getRowsForWeek(week) {
    const sessionsTitle = CURRENT_WEEK <= 2 ? "Mes 2 séances" : "Mes 3 séances";
    return [
      { key: "week_action", title: "Mon action", subtitle: "Cette semaine", objective: `${week.kcal} kcal`, focus: week.focus, button: "Voir" },
      { key: "week_planning", title: "Créer mon planning", subtitle: "Semaine", objective: `${week.kcal} kcal`, focus: "Menu", button: "Voir" },
      { key: "week_training", title: sessionsTitle, subtitle: "Intégration", objective: `${week.kcal} kcal`, focus: "Training", button: "Voir" },
      { key: "week_timing", title: "Quand manger", subtitle: "Dans ma journée", objective: `${week.kcal} kcal`, focus: "Timing", button: "Voir" }
    ];
  }

  function bindSingleAccordion() {
    const item = document.getElementById("singlePopupAcc");
    const btn  = document.getElementById("singlePopupAccBtn");
    if (!item || !btn) return;
    btn.onclick = function(e) {
      e.stopPropagation();
      item.classList.toggle("open");
    };
  }

  function setPopupContent(sectionKey, week) {
    document.getElementById("popupTitle").textContent   = week.week;
    document.getElementById("popupKcal").textContent    = `${week.kcal} kcal / jour`;
    document.getElementById("popupTag").textContent     = week.focus;
    document.getElementById("popupMiniIntro").innerHTML = week.intro;

    const sectionTitle   = document.getElementById("popupSectionTitle");
    const sectionContent = document.getElementById("popupSectionContent");

    if (sectionKey === "week_action") {
      sectionTitle.textContent = "🎯 Cette semaine";
      sectionContent.innerHTML = buildTopWhatContent(week) + `<div style="height:12px;"></div>` + buildTopActionContent(week);
      return;
    }
    if (sectionKey === "week_planning") {
      sectionTitle.textContent = "🗓️ Créer mon planning semaine";
      sectionContent.innerHTML = buildFoodPlanningContent(week);
      return;
    }
    if (sectionKey === "week_training") {
      sectionTitle.textContent = CURRENT_WEEK <= 2
        ? "🏋️ Comment intégrer mes 2 séances"
        : "🏋️ Comment intégrer mes 3 séances";
      sectionContent.innerHTML = stripBullets(week.training);
      return;
    }
    if (sectionKey === "week_timing") {
      sectionTitle.textContent = "⏰ Quand manger dans ma journée";
      fillTimingPlanner();
    }
  }

  function positionPopup(triggerEl) {
    const overlay = document.getElementById("nutritionPopupOverlay");
    const popup   = document.getElementById("nutritionPopup");
    const overlayPad = window.innerWidth <= 600 ? 12 : 20;

    overlay.style.alignItems = "flex-start";

    if (!triggerEl) {
      popup.style.marginTop    = Math.max(20, (window.innerHeight - popup.offsetHeight) / 2) + "px";
      popup.style.marginBottom = "20px";
      return;
    }

    const rect = triggerEl.getBoundingClientRect();
    const popupH = popup.offsetHeight;
    let idealTop = rect.top + rect.height / 2 - popupH / 2;

    idealTop = Math.max(overlayPad, Math.min(idealTop, window.innerHeight - popupH - overlayPad));

    popup.style.marginTop    = Math.max(0, idealTop - overlayPad) + "px";
    popup.style.marginBottom = "20px";
  }

  function openPopup(sectionKey, week, triggerEl) {
    setPopupContent(sectionKey, week);
    const overlay   = document.getElementById("nutritionPopupOverlay");
    const popup     = document.getElementById("nutritionPopup");
    const singleAcc = document.getElementById("singlePopupAcc");

    overlay.style.display = "flex";
    popup.scrollTop = 0;
    bindSingleAccordion();
    if (singleAcc) singleAcc.classList.remove("open");

    requestAnimationFrame(() => positionPopup(triggerEl));
  }

  function closePopup() {
    const overlay = document.getElementById("nutritionPopupOverlay");
    const popup   = document.getElementById("nutritionPopup");
    overlay.style.display    = "none";
    popup.scrollTop          = 0;
    popup.style.marginTop    = "0";
    popup.style.marginBottom = "0";
  }

  function renderPlan() {
    const goal   = document.getElementById("goalType")?.value || "cut";
    const need   = parseFloat(document.getElementById("needCalories").value);
    const intake = parseFloat(document.getElementById("currentIntake").value);
    const weight = parseFloat(document.getElementById("bodyWeight").value);

    if (!isFinite(need) || need <= 0) {
      alert(isWeekOne()
        ? "Entre un besoin calorique valide."
        : "Ton besoin calorique n’a pas été retrouvé depuis la semaine 1. Vérifie que la semaine 1 a bien été validée sur le même appareil et le même navigateur.");
      return;
    }

    if (!isFinite(intake) || intake <= 0) {
      alert(isWeekOne()
        ? "Entre tes apports actuels."
        : "Tes apports actuels n’ont pas été retrouvés depuis la semaine 1. Vérifie que la semaine 1 a bien été validée sur le même appareil et le même navigateur.");
      return;
    }

    if (!isFinite(weight) || weight <= 0) {
      alert(isWeekOne()
        ? "Entre un poids valide."
        : "Ton poids n’a pas été retrouvé depuis la semaine 1. Vérifie que la semaine 1 a bien été validée sur le même appareil et le même navigateur.");
      return;
    }

    if (isWeekOne()) {
      if (need < 1200 || need > 5000) { alert("Ton besoin calorique semble irréel (entre 1200 et 5000 kcal). Vérifie ta saisie."); return; }
      if (intake < 500 || intake > 6000) { alert("Tes apports actuels semblent irréels (entre 500 et 6000 kcal). Vérifie ta saisie."); return; }
      if (weight < 30 || weight > 250) { alert("Ton poids semble irréel (entre 30 et 250 kg). Vérifie ta saisie."); return; }
    }

    state.goal    = goal;
    state.need    = Math.round(need);
    state.intake  = Math.round(intake);
    state.protein = Math.round(weight * 2);

    const profileData = goal === "gain"
      ? getGainProfile(state.need, state.intake)
      : getCutProfile(state.need, state.intake);

    state.profile = profileData.profile;
    state.profileFamily = profileData.family;
    state.weeklyCalories = goal === "gain"
      ? buildGainCalories(state.profile, state.need, state.intake)
      : buildCutCalories(state.profile, state.need, state.intake);

    saveFormData();
    initWeekRecapView();

    const intro = getIntro(state.goal, state.profileFamily, state.need, state.intake, state.protein);
    document.getElementById("introTitle").textContent = intro.title;
    document.getElementById("introText").textContent  = intro.text;
    document.getElementById("introMeta").innerHTML    = intro.meta;
    document.getElementById("planIntro").style.display = "block";
    document.getElementById("nutritionTableDesktopWrap").style.display = "block";

    const week = getCurrentWeekContent(state.goal, state.profileFamily, state.need, state.intake, state.weeklyCalories);
    const rows = getRowsForWeek(week);
    const tbody = document.getElementById("weeksTableBody");
    tbody.innerHTML = "";

    rows.forEach((row, index) => {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>
          <div class="exo-card">
            <div class="exo-number">(0${index + 1})</div>
            <div class="exo-name">
              <span class="main">${row.title}</span>
              <span class="sub">${row.subtitle}</span>
            </div>
          </div>
        </td>
        <td>${row.objective}</td>
        <td>${row.focus}</td>
        <td><button type="button" class="openBtn" data-key="${row.key}">${row.button}</button></td>
      `;
      tr.addEventListener("click", function () {
        openPopup(row.key, week, tr);
      });
      tbody.appendChild(tr);
    });
  }

  document.getElementById("generateNutritionPlan").addEventListener("click", renderPlan);
  document.getElementById("closeNutritionPopup").addEventListener("click", closePopup);
  document.getElementById("nutritionPopupOverlay").addEventListener("click", (e) => {
    if (e.target.id === "nutritionPopupOverlay") closePopup();
  });

  ["wakeTime","trainingTime","lunchTime","dinnerTime","sleepTime"].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    const maybeRefresh = () => {
      const overlay = document.getElementById("nutritionPopupOverlay");
      if (overlay.style.display !== "none") {
        const t = document.getElementById("popupSectionTitle").textContent || "";
        if (t.includes("Quand manger")) fillTimingPlanner();
      }
    };
    el.addEventListener("change", maybeRefresh);
    el.addEventListener("input", maybeRefresh);
  });

  loadFormData();
  bindAutoSave();
  initWeekVisibility();
})();
</script>
