<script>
(function () {
  const CURRENT_WEEK = 1; // change juste ici : 1 à 8
  const STORAGE_KEY = "bblBodyNutritionDual_v1";

  const state = {
    goal: "cut",
    need: 2000,
    intake: 1500,
    protein: 140,
    profile: "",
    profileFamily: "",
    weeklyCalories: []
  };

  const CYRIL_LIGNAC_ANNEX = `
    <div class="week-annex-box" style="margin-top:14px;">
      <a href="https://www.thenarcissichealth.fr/school/course/bblnaturel/lecture/9687816" class="cyrilAnnexBtn">Je prépare mon menu</a>
    </div>
  `;

  function isWeekOne() {
    return CURRENT_WEEK === 1;
  }

  function getSessionsCount() {
    return CURRENT_WEEK <= 2 ? 2 : 3;
  }

  function getSessionsLabel() {
    return getSessionsCount() + " séances bas du corps";
  }

  function round50(v) {
    return Math.round(v / 50) * 50;
  }

  function parseTimeToMinutes(v) {
    if (!v || !v.includes(":")) return null;
    const [h, m] = v.split(":").map(Number);
    if (!Number.isFinite(h) || !Number.isFinite(m) || h < 0 || h > 23 || m < 0 || m > 59) return null;
    return h * 60 + m;
  }

  function formatMinutes(mins) {
    const normalized = ((mins % 1440) + 1440) % 1440;
    const h = Math.floor(normalized / 60);
    const m = normalized % 60;
    return String(h).padStart(2, "0") + ":" + String(m).padStart(2, "0");
  }

  function stripBullets(html) {
    return (html || "")
      .replace(/<ul>/g, '<div class="listClean">')
      .replace(/<\/ul>/g, '</div>')
      .replace(/<li>/g, '<div class="listLine">')
      .replace(/<\/li>/g, '</div>');
  }

  function saveFormData() {
    const data = {
      goalType: document.getElementById("goalType")?.value || "cut",
      needCalories: document.getElementById("needCalories")?.value || "",
      currentIntake: document.getElementById("currentIntake")?.value || "",
      bodyWeight: document.getElementById("bodyWeight")?.value || "",
      wakeTime: document.getElementById("wakeTime")?.value || "",
      trainingTime: document.getElementById("trainingTime")?.value || "",
      lunchTime: document.getElementById("lunchTime")?.value || "",
      dinnerTime: document.getElementById("dinnerTime")?.value || "",
      sleepTime: document.getElementById("sleepTime")?.value || ""
    };
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } catch(e) {}
  }

  function loadFormData() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);

      if (data.goalType && document.getElementById("goalType")) document.getElementById("goalType").value = data.goalType;
      if (data.needCalories) document.getElementById("needCalories").value = data.needCalories;
      if (data.currentIntake) document.getElementById("currentIntake").value = data.currentIntake;
      if (data.bodyWeight) document.getElementById("bodyWeight").value = data.bodyWeight;
      if (data.wakeTime) document.getElementById("wakeTime").value = data.wakeTime;
      if (data.trainingTime) document.getElementById("trainingTime").value = data.trainingTime;
      if (data.lunchTime) document.getElementById("lunchTime").value = data.lunchTime;
      if (data.dinnerTime) document.getElementById("dinnerTime").value = data.dinnerTime;
      if (data.sleepTime) document.getElementById("sleepTime").value = data.sleepTime;
    } catch(e) {}
  }

  function bindAutoSave() {
    ["goalType","needCalories","currentIntake","bodyWeight","wakeTime","trainingTime","lunchTime","dinnerTime","sleepTime"].forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      el.addEventListener("input", function () {
        saveFormData();
        initWeekRecapView();
      });
      el.addEventListener("change", function () {
        saveFormData();
        initWeekRecapView();
      });
    });
  }

  function initWeekVisibility() {
    const goalBlock = document.getElementById("goalBlock");
    const baseInputsBlock = document.getElementById("baseInputsBlock");
    const recapBox = document.getElementById("weekRecapBox");

    if (isWeekOne()) {
      if (goalBlock) goalBlock.style.display = "grid";
      if (baseInputsBlock) baseInputsBlock.style.display = "grid";
      if (recapBox) recapBox.style.display = "none";
      return;
    }

    if (goalBlock) goalBlock.style.display = "none";
    if (baseInputsBlock) baseInputsBlock.style.display = "none";
    initWeekRecapView();
  }

  function initWeekRecapView() {
    if (isWeekOne()) return;

    const goal = document.getElementById("goalType")?.value || "cut";
    const need = document.getElementById("needCalories")?.value;
    const intake = document.getElementById("currentIntake")?.value;
    const weight = document.getElementById("bodyWeight")?.value;
    const recapBox = document.getElementById("weekRecapBox");
    if (!recapBox) return;

    if (need && intake && weight) {
      recapBox.style.display = "block";
      recapBox.innerHTML = `
        Plan déjà initialisé<br>
        Objectif : <b>${goal === "gain" ? "prise de masse" : "perte de gras"}</b> •
        Besoin calorique : <b>${need} kcal</b> •
        Apports actuels : <b>${intake} kcal</b> •
        Poids : <b>${weight} kg</b>
      `;
    } else {
      recapBox.style.display = "none";
      recapBox.innerHTML = "";
    }
  }

  /* ============================================================
     PROFILS CUT
     ============================================================ */

function getCutProfile(need, intake) {
  const delta = intake - need;

  if (delta <= -450) return { profile: "cut_under_strong", family: "under" };
  if (delta <= -350) return { profile: "cut_under_medium", family: "under" };
  if (delta <= -250) return { profile: "cut_under_moderate", family: "under" };

  if (delta <= -150) return { profile: "cut_around_low", family: "around" };
  if (delta <= -50)  return { profile: "cut_maintenance_low", family: "around" };
  if (delta <= 50)   return { profile: "cut_maintenance_real", family: "around" };
  if (delta <= 150)  return { profile: "cut_maintenance_high", family: "around" };

  if (delta <= 250)  return { profile: "cut_surplus_clean", family: "over" };
  if (delta <= 350)  return { profile: "cut_surplus_high", family: "over" };
  if (delta <= 450)  return { profile: "cut_surplus_very_high", family: "over" };
  return { profile: "cut_surplus_too_high", family: "over" };
}

function buildCutCalories(profile, need, intake) {
  if (profile === "cut_under_strong") {
    return [
      round50(intake + 150), // S1
      round50(intake + 300), // S2
      round50(need - 100),   // S3
      round50(need - 150),   // S4
      round50(need - 200),   // S5
      round50(need - 200),   // S6
      round50(need - 150),   // S7
      round50(need - 100)    // S8
    ];
  }

  if (profile === "cut_under_medium") {
    return [
      round50(intake + 150), // S1
      round50(need - 100),   // S2
      round50(need - 100),   // S3
      round50(need - 150),   // S4
      round50(need - 200),   // S5
      round50(need - 200),   // S6
      round50(need - 150),   // S7
      round50(need - 100)    // S8
    ];
  }

  if (profile === "cut_under_moderate") {
    return [
      round50(intake + 150), // S1
      round50(need - 50),    // S2
      round50(need - 100),   // S3
      round50(need - 150),   // S4
      round50(need - 200),   // S5
      round50(need - 200),   // S6
      round50(need - 150),   // S7
      round50(need - 100)    // S8
    ];
  }

  if (profile === "cut_around_low") {
    return [
      round50(intake + 100), // S1
      round50(need),         // S2
      round50(need - 100),   // S3
      round50(need - 150),   // S4
      round50(need - 200),   // S5
      round50(need - 200),   // S6
      round50(need - 150),   // S7
      round50(need - 100)    // S8
    ];
  }

  if (profile === "cut_maintenance_low") {
    return [
      round50(need),         // S1
      round50(need - 50),    // S2
      round50(need - 100),   // S3
      round50(need - 150),   // S4
      round50(need - 200),   // S5
      round50(need - 200),   // S6
      round50(need - 150),   // S7
      round50(need - 100)    // S8
    ];
  }

  if (profile === "cut_maintenance_real") {
    return [
      round50(need),         // S1
      round50(need - 50),    // S2
      round50(need - 100),   // S3
      round50(need - 150),   // S4
      round50(need - 200),   // S5
      round50(need - 200),   // S6
      round50(need - 150),   // S7
      round50(need - 100)    // S8
    ];
  }

  if (profile === "cut_maintenance_high") {
    return [
      round50(intake - 50),  // S1
      round50(need - 50),    // S2
      round50(need - 100),   // S3
      round50(need - 150),   // S4
      round50(need - 200),   // S5
      round50(need - 200),   // S6
      round50(need - 150),   // S7
      round50(need - 100)    // S8
    ];
  }

  if (profile === "cut_surplus_clean") {
    return [
      round50(intake - 100), // S1
      round50(need),         // S2
      round50(need - 100),   // S3
      round50(need - 150),   // S4
      round50(need - 200),   // S5
      round50(need - 200),   // S6
      round50(need - 150),   // S7
      round50(need - 100)    // S8
    ];
  }

  if (profile === "cut_surplus_high") {
    return [
      round50(intake - 100), // S1
      round50(intake - 250), // S2
      round50(need - 50),    // S3
      round50(need - 150),   // S4
      round50(need - 200),   // S5
      round50(need - 200),   // S6
      round50(need - 150),   // S7
      round50(need - 100)    // S8
    ];
  }

  if (profile === "cut_surplus_very_high") {
    return [
      round50(intake - 150), // S1
      round50(intake - 300), // S2
      round50(need - 50),    // S3
      round50(need - 150),   // S4
      round50(need - 200),   // S5
      round50(need - 200),   // S6
      round50(need - 150),   // S7
      round50(need - 100)    // S8
    ];
  }

  return [
    round50(intake - 200),   // S1
    round50(intake - 350),   // S2
    round50(need),           // S3
    round50(need - 100),     // S4
    round50(need - 150),     // S5
    round50(need - 150),     // S6
    round50(need - 100),     // S7
    round50(need - 50)       // S8
  ];
}



/* ============================================================
   PROFILS GAIN — logique BBL BODY plus évolutive
   ============================================================ */
function getGainProfile(need, intake) {
  const delta = intake - need;

  if (delta <= -450) return { profile: "gain_under_strong", family: "under" };
  if (delta <= -300) return { profile: "gain_under_medium", family: "under" };
  if (delta <= -200) return { profile: "gain_under_moderate", family: "under" };

  if (delta <= -100) return { profile: "gain_around_low", family: "around" };
  if (delta < 50)    return { profile: "gain_maintenance_real", family: "around" };
  if (delta <= 200)  return { profile: "gain_surplus_clean", family: "around" };

  if (delta <= 350) return { profile: "gain_over_light", family: "over" };
  return { profile: "gain_over_high", family: "over" };
}

function buildGainCalories(profile, need, intake) {
  if (profile === "gain_under_strong") {
    return [
      round50(need - 200), // S1
      round50(need - 100), // S2
      round50(need),       // S3
      round50(need + 100), // S4
      round50(need + 200), // S5
      round50(need + 300), // S6
      round50(need + 400), // S7
      round50(need + 400)  // S8
    ];
  }

  if (profile === "gain_under_medium") {
    return [
      round50(need - 150), // S1
      round50(need - 50),  // S2
      round50(need + 50),  // S3
      round50(need + 150), // S4
      round50(need + 250), // S5
      round50(need + 300), // S6
      round50(need + 350), // S7
      round50(need + 350)  // S8
    ];
  }

  if (profile === "gain_under_moderate") {
    return [
      round50(need - 100), // S1
      round50(need),       // S2
      round50(need + 100), // S3
      round50(need + 150), // S4
      round50(need + 200), // S5
      round50(need + 250), // S6
      round50(need + 300), // S7
      round50(need + 300)  // S8
    ];
  }

  if (profile === "gain_around_low") {
    return [
      round50(need),       // S1
      round50(need + 50),  // S2
      round50(need + 100), // S3
      round50(need + 150), // S4
      round50(need + 200), // S5
      round50(need + 250), // S6
      round50(need + 300), // S7
      round50(need + 300)  // S8
    ];
  }

  if (profile === "gain_maintenance_real") {
    return [
      round50(need + 50),  // S1
      round50(need + 100), // S2
      round50(need + 150), // S3
      round50(need + 200), // S4
      round50(need + 250), // S5
      round50(need + 250), // S6
      round50(need + 300), // S7
      round50(need + 300)  // S8
    ];
  }

  if (profile === "gain_surplus_clean") {
    return [
      round50(intake),     // S1
      round50(intake),     // S2
      round50(need + 150), // S3
      round50(need + 200), // S4
      round50(need + 200), // S5
      round50(need + 200), // S6
      round50(need + 250), // S7
      round50(need + 250)  // S8
    ];
  }

  if (profile === "gain_over_light") {
    return [
      round50(intake - 50), // S1
      round50(need + 200),  // S2
      round50(need + 200),  // S3
      round50(need + 200),  // S4
      round50(need + 200),  // S5
      round50(need + 200),  // S6
      round50(need + 250),  // S7
      round50(need + 250)   // S8
    ];
  }

  return [
    round50(intake - 100), // S1
    round50(intake - 150), // S2
    round50(need + 200),   // S3
    round50(need + 200),   // S4
    round50(need + 200),   // S5
    round50(need + 200),   // S6
    round50(need + 250),   // S7
    round50(need + 250)    // S8
  ];
}


  function getWeekCaloriesPair(weeklyCalories, currentWeekNumber) {
    const currentIndex = currentWeekNumber - 1;
    return {
      currentKcal: weeklyCalories[currentIndex],
      previousKcal: currentIndex > 0 ? weeklyCalories[currentIndex - 1] : null
    };
  }

  function getWeekChangeType(previousKcal, currentKcal) {
    if (previousKcal == null) return "start";
    if (currentKcal === previousKcal) return "same";
    if (currentKcal < previousKcal) return "down";
    return "up";
  }

  function getGoalLabel(currentKcal, previousKcal) {
    if (previousKcal == null) return "Point de départ";
    if (currentKcal > previousKcal) return "Augmentation";
    if (currentKcal < previousKcal) return "Ajustement";
    return "Stabilisation";
  }

  function buildAdaptiveIntro(goal, profileFamily, previousKcal, currentKcal, weekNumber) {
    const changeType = getWeekChangeType(previousKcal, currentKcal);

    if (goal === "gain") {
      if (weekNumber <= 2) {
        if (changeType === "start") {
          return `Cette semaine, tu poses ton premier palier à <b>${currentKcal} kcal</b>. Le but est de remettre de l’énergie doucement et de lancer le programme sur une base plus solide.`;
        }
        if (changeType === "up") {
          return `Cette semaine, tu montes de <b>${previousKcal} kcal</b> à <b>${currentKcal} kcal</b>. Le but est de continuer la relance sans brûler les étapes.`;
        }
        if (changeType === "same") {
          return `Cette semaine, tu restes à <b>${currentKcal} kcal</b>. Le but est de stabiliser cette base avant la montée du volume d’entraînement.`;
        }
        return `Cette semaine, tu ajustes à <b>${currentKcal} kcal</b>. Le but est de garder un surplus plus propre et plus utile.`;
      }

      if (weekNumber <= 6) {
        if (changeType === "up") {
          return `Cette semaine, tu montes à <b>${currentKcal} kcal</b> pour accompagner les <b>3 séances bas du corps</b> et soutenir la construction.`;
        }
        if (changeType === "same") {
          return `Cette semaine, tu restes à <b>${currentKcal} kcal</b>. Le but est de consolider un surplus utile à la progression, à la récup et aux perfs.`;
        }
        return `Cette semaine, tu ajustes à <b>${currentKcal} kcal</b>. Le but est de garder un cadre propre sans surplus inutile.`;
      }

      if (changeType === "up") {
        return `Cette semaine, tu montes légèrement à <b>${currentKcal} kcal</b> pour consolider la fin du programme.`;
      }
      if (changeType === "same") {
        return `Cette semaine, tu restes à <b>${currentKcal} kcal</b>. Le but est de stabiliser ce qui fonctionne vraiment sur toi.`;
      }
      return `Cette semaine, tu ajustes à <b>${currentKcal} kcal</b> pour finir sur un cadre plus propre et plus lisible.`;
    }

    if (weekNumber <= 2) {
      if (changeType === "start") return `Cette semaine, tu poses ton premier palier à <b>${currentKcal} kcal</b>. Le but est de recalibrer proprement sans partir dans l’extrême.`;
      if (changeType === "up") return `Cette semaine, tu remontes à <b>${currentKcal} kcal</b>. Le but est de remettre ton corps sur une base plus cohérente.`;
      if (changeType === "same") return `Cette semaine, tu restes à <b>${currentKcal} kcal</b>. Le but est de stabiliser ce cadre avant la suite.`;
      return `Cette semaine, tu descends à <b>${currentKcal} kcal</b>. Le but est de retirer l’excédent sans violence inutile.`;
    }

    if (weekNumber <= 6) {
      if (changeType === "up") return `Cette semaine, tu remontes légèrement à <b>${currentKcal} kcal</b> pour garder un déficit plus tenable.`;
      if (changeType === "same") return `Cette semaine, tu restes à <b>${currentKcal} kcal</b>. Le but est de consolider ce niveau sans compenser.`;
      return `Cette semaine, tu descends à <b>${currentKcal} kcal</b> pour continuer le déficit proprement.`;
    }

    if (changeType === "same") return `Cette semaine, tu restes à <b>${currentKcal} kcal</b>. Le but est de finir le programme avec de la stabilité.`;
    if (changeType === "up") return `Cette semaine, tu remontes légèrement à <b>${currentKcal} kcal</b> pour garder un cadre tenable jusqu’au bout.`;
    return `Cette semaine, tu ajustes à <b>${currentKcal} kcal</b> pour finir sur un déficit propre, sans casser ton énergie.`;
  }

  function getIntro(goal, profileFamily, need, intake, protein) {
    if (goal === "gain") {
      if (profileFamily === "under") {
        return {
          title: `prise de masse — semaine ${CURRENT_WEEK}`,
          text: "Aujourd'hui tu manges trop peu pour vraiment construire. On commence donc par remettre de l'énergie, puis on installe un surplus propre en suivant la montée du programme BBL BODY.",
          meta: `Besoin calorique : <b>${need} kcal</b> • Apports actuels : <b>${intake} kcal</b> • Protéines cible : <b>${protein} g / jour</b>`
        };
      }
      if (profileFamily === "over") {
        return {
          title: `prise de masse — semaine ${CURRENT_WEEK}`,
          text: "Aujourd'hui tu manges déjà au-dessus de ton besoin. Le but n'est pas de manger encore plus, mais de garder seulement le surplus utile à la progression et à la construction.",
          meta: `Besoin calorique : <b>${need} kcal</b> • Apports actuels : <b>${intake} kcal</b> • Protéines cible : <b>${protein} g / jour</b>`
        };
      }
      return {
        title: `prise de masse — semaine ${CURRENT_WEEK}`,
        text: "Aujourd'hui tu es déjà autour de ton besoin ou légèrement au-dessus. Donc on ajuste proprement en fonction du volume d'entraînement pour construire sans surplus inutile.",
        meta: `Besoin calorique : <b>${need} kcal</b> • Apports actuels : <b>${intake} kcal</b> • Protéines cible : <b>${protein} g / jour</b>`
      };
    }

    if (profileFamily === "under") {
      return {
        title: `perte de gras — semaine ${CURRENT_WEEK}`,
        text: "Aujourd'hui tu manges trop peu par rapport à ce dont ton corps a vraiment besoin. Donc on remet d'abord ton corps en sécurité avant de créer un déficit plus propre.",
        meta: `Besoin calorique : <b>${need} kcal</b> • Apports actuels : <b>${intake} kcal</b> • Protéines cible : <b>${protein} g / jour</b>`
      };
    }
    if (profileFamily === "over") {
      return {
        title: `perte de gras — semaine ${CURRENT_WEEK}`,
        text: "Aujourd'hui tu manges au-dessus de ton besoin. Donc on retire une partie de l'excédent sans rentrer dans un mode punition.",
        meta: `Besoin calorique : <b>${need} kcal</b> • Apports actuels : <b>${intake} kcal</b> • Protéines cible : <b>${protein} g / jour</b>`
      };
    }
    return {
