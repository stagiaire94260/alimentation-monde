  function getDaySchedule() {
    const wake = parseTimeToMinutes(document.getElementById("wakeTime").value);
    const trainingStartRaw = parseTimeToMinutes(document.getElementById("trainingTime").value);
    const lunchRaw = parseTimeToMinutes(document.getElementById("lunchTime").value);
    const dinnerRaw = parseTimeToMinutes(document.getElementById("dinnerTime").value);
    const sleepRaw = parseTimeToMinutes(document.getElementById("sleepTime").value);

    if ([wake, trainingStartRaw, lunchRaw, dinnerRaw, sleepRaw].some(v => v === null)) {
      return { ok: false, error: "Remplis correctement tous tes horaires." };
    }

    let trainingStart = trainingStartRaw;
    let lunch = lunchRaw;
    let dinner = dinnerRaw;
    let sleep = sleepRaw;

    if (sleep <= wake) sleep += 1440;
    if (dinner <= wake) dinner += 1440;
    if (lunch <= wake) lunch += 1440;
    if (trainingStart <= wake) trainingStart += 1440;

    if (trainingStart <= wake) return { ok: false, error: "Ton training doit être après ton réveil." };
    if (lunch <= wake) return { ok: false, error: "Ton déjeuner doit être après ton réveil." };
    if (dinner <= lunch) return { ok: false, error: "Ton dîner doit être après ton déjeuner." };
    if (sleep <= dinner) return { ok: false, error: "Ton coucher doit être après ton dîner." };

    return { ok: true, wake, trainingStart, trainingEnd: trainingStart + 60, lunch, dinner, sleep };
  }

  function buildTimingRows() {
    const schedule = getDaySchedule();
    if (!schedule.ok) return { ok: false, message: schedule.error, alert: "", rows: [] };

    const { wake, trainingStart, trainingEnd, lunch, dinner, sleep } = schedule;
    const rows = [];
    const alerts = [];

    function addRow(mins, title, food, details) {
      if (mins == null) return;
      rows.push({ hour: formatMinutes(mins), title, food: food || "", details: details || "" });
    }

    const diffWakeToTraining = trainingStart - wake;
    const lunchTooCloseToTraining = lunch >= (trainingStart - 45) && lunch <= (trainingEnd + 30);
    const dinnerTooCloseToTraining = dinner >= (trainingStart - 45) && dinner <= (trainingEnd + 30);
    const isVeryLateTraining = trainingStart >= 21 * 60;
    const isMorningTraining = trainingStart < 12 * 60;
    const isAfternoonTraining = trainingStart >= 12 * 60 && trainingStart < 20 * 60;
    const isEveningTraining = trainingStart >= 20 * 60;

    addRow(wake, "🌞 Réveil", "Grand verre d'eau.", "On réveille doucement ton corps avant d'envoyer la journée.");

    if (isMorningTraining) {
      if (diffWakeToTraining < 75) {
        const preTraining = trainingStart - 45;
        if (preTraining <= wake) {
          return { ok: false, message: "Tes horaires sont trop serrés. Avance ton réveil ou décale ton training.", alert: "", rows: [] };
        }
        addRow(preTraining, "🍌 Pré-training", "Petit apport digeste obligatoire avant la séance.", "Ici on ne part pas à vide.<br><em>Ex : banane, compote, yaourt, tranche de pain + miel.</em>");
        addRow(trainingStart, "🏋️ Training", "", "");
        if ((lunch - trainingEnd) < 120) {
          addRow(trainingEnd + 15, "🥛 Collation protéinée", "Protéines juste après la séance.", "Comme le déjeuner arrive vite, on met juste une collation protéinée.");
        } else {
          addRow(trainingEnd + 20, "🥑 Petit-déjeuner", "Protéines + glucides + bons lipides.", "Le déjeuner est encore loin, tu peux faire un vrai petit-déj après la séance.");
        }
        const lunchAfterTraining = Math.max(lunch, trainingEnd + 60);
        if (lunchAfterTraining !== lunch) alerts.push("Ton déjeuner a été légèrement décalé après la séance.");
        addRow(lunchAfterTraining, "🍽️ Déjeuner", "Glucides + protéines + légumes.", "Un vrai repas structuré après ta séance.");
      } else {
        const breakfastBefore = (trainingStart - (wake + 30)) >= 60 ? wake + 30 : null;
        let preTraining = null;
        if ((trainingStart - wake) > 90) {
          const candidate = trainingStart - 45;
          if (!breakfastBefore || (candidate - breakfastBefore) >= 60) preTraining = candidate;
        }
        if (breakfastBefore) addRow(breakfastBefore, "🥑 Petit-déjeuner", "Protéines + glucides + bons lipides.", "Ton training est assez loin du réveil, tu peux faire un vrai petit-déj avant.");
        if (preTraining) addRow(preTraining, "🍌 Pré-training", "Petit apport digeste avant la séance.", "Tu l'ajoutes si ta séance est éloignée du petit-déj.");
        addRow(trainingStart, "🏋️ Training", "", "");
        if ((lunch - trainingEnd) > 90) addRow(trainingEnd + 20, "🥛 Collation protéinée", "Shaker protéiné ou collation protéinée.", "Le déjeuner est encore loin, on ajoute une collation protéinée pour la récup.");
        const lunchAfterTraining = lunchTooCloseToTraining ? trainingEnd + 45 : lunch;
        if (lunchTooCloseToTraining) alerts.push("Ton déjeuner était trop proche de la séance, il a été replacé après.");
        addRow(lunchAfterTraining, "🍽️ Déjeuner", "Glucides + protéines + légumes.", "Un vrai repas structuré pour tenir ton objectif calorique.");
      }
    } else if (isAfternoonTraining) {
      addRow(wake + 30, "🥑 Petit-déjeuner", "Protéines + glucides + bons lipides.", "Un vrai petit-déj pour lancer la journée.");
      if (lunchTooCloseToTraining) {
        const preTraining = trainingStart - 45;
