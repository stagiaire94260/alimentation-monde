    {l:"Arrêter de manger par habitude ou obligation et manger vraiment pour moi.",v:"reg"},
    {l:"Apprendre à distinguer la faim réelle de l'envie de manger pour le plaisir.",v:"vis"},
    {l:"Arrêter d'avoir peur de certains aliments et manger sans me faire la guerre.",v:"ctl"},
