var container=document.getElementById("qsteps");
var prevBtn=document.getElementById("qprev");
var nextBtn=document.getElementById("qnext");
var errBox=document.getElementById("qerror");
var bar=document.getElementById("qbar");
var stepTxt=document.getElementById("qstep");
var resultsEl=document.getElementById("qresults");
var answers={},cur=1,tot=Q.length;

container.innerHTML=Q.map(function(q){
  var opts=q.opts.map(function(o){
    return '<button type="button" class="q-opt" data-name="'+q.name+'" data-value="'+o.v+'">'+o.l+'</button>';
  }).join("");
  return '<div class="q-step" data-step="'+q.step+'"'+(q.step>1?' hidden':'')+'>'+
    '<div class="q-card"><div class="q-badge">Question '+q.step+' / '+tot+'</div>'+
    '<div class="q-title">'+q.q+'</div><div class="q-opts">'+opts+'</div></div></div>';
}).join("");

function restoreSel(){
  container.querySelectorAll(".q-opt").forEach(function(b){
    b.classList.toggle("sel",answers[b.dataset.name]===b.dataset.value);
  });
}
container.addEventListener("click",function(e){
  var b=e.target.closest(".q-opt");
  if(!b)return;
  answers[b.dataset.name]=b.dataset.value;
  errBox.textContent="";
  restoreSel();
});
function update(){
  container.querySelectorAll(".q-step").forEach(function(s){s.hidden=parseInt(s.dataset.step)!==cur;});
  stepTxt.textContent="Question "+cur+" sur "+tot;
  bar.style.width=Math.round(((cur-1)/tot)*100)+"%";
  prevBtn.disabled=cur===1;prevBtn.style.opacity=cur===1?".5":"1";
  nextBtn.textContent=cur===tot?"Voir mon profil":"Suivant";
  restoreSel();
}
function answered(){return !!answers[Q[cur-1].name];}
function getScores(){
  var cnt={reg:0,vis:0,ctl:0,emo:0};
  Q.forEach(function(q){var v=answers[q.name];if(v&&cnt[v]!==undefined)cnt[v]++;});
  return cnt;
}
function pickProfile(cnt){return Object.keys(cnt).reduce(function(a,b){return cnt[a]>=cnt[b]?a:b;});}
function bindAcc(el){
  el.querySelectorAll(".acc-btn").forEach(function(b){
    b.addEventListener("click",function(){this.parentElement.classList.toggle("open");});
  });
}
function showResults(){
  var cnt=getScores(),key=pickProfile(cnt),p=PROFILES[key];
  var barsHtml=["reg","vis","ctl","emo"].map(function(k){
    var pct=Math.round((cnt[k]/tot)*100);
    return '<div class="score-row">'+
      '<div class="score-label">'+LABELS[k]+'</div>'+
      '<div class="score-track"><div class="score-fill '+FILLS[k]+'" data-pct="'+pct+'" style="width:0%"></div></div>'+
      '<div class="score-pct">'+pct+'%</div></div>';
  }).join("");
  var tagsHtml=p.croyances.map(function(c){return '<span class="cr-tag">'+c+'</span>';}).join("");
  var compsHtml=p.comps.length?
    '<div class="acc-block" style="margin-top:8px;"><div class="acc-label">Compléments qui peuvent aider</div>'+
    '<div class="cr-tags" style="margin-top:6px;">'+p.comps.map(function(c){return '<span class="cr-tag">'+c+'</span>';}).join("")+'</div>'+
    '<a class="comp-link" href="'+COMP_URL+'" target="_blank">Voir le guide compléments</a></div>':"";
  resultsEl.innerHTML=
    '<div class="qr-wrap">'+
      '<div class="qr-head">'+
        '<div class="qr-badge">Ton profil dominant</div>'+
        '<div class="qr-profil">'+p.profil+'</div>'+
        '<div class="qr-tagline">'+p.tagline+'</div>'+
      '</div>'+
      '<div class="qr-body">'+
        '<div class="score-section"><div class="score-title">Ton score par profil</div>'+barsHtml+'</div>'+
        '<div class="acc-item open"><button class="acc-btn" type="button"><span class="acc-btn-title">Ce que ça dit de toi</span><span class="acc-arrow">+</span></button>'+
          '<div class="acc-content"><div class="acc-block"><p class="acc-text">'+p.analyse+'</p></div></div></div>'+
        '<div class="acc-item open"><button class="acc-btn" type="button"><span class="acc-btn-title">Plan d&#39;action</span><span class="acc-arrow">+</span></button>'+
          '<div class="acc-content"><div class="acc-block"><p class="acc-text">'+p.action+'</p></div>'+compsHtml+'</div></div>'+
        '<div class="acc-item"><button class="acc-btn" type="button"><span class="acc-btn-title">Ce que la science dit</span><span class="acc-arrow">+</span></button>'+
          '<div class="acc-content"><div class="pepite"><div class="pepite-label">La science</div><p class="pepite-text">'+p.pepite+'</p></div></div></div>'+
        '<div class="acc-item"><button class="acc-btn" type="button"><span class="acc-btn-title">Les croyances qui vont avec ton profil</span><span class="acc-arrow">+</span></button>'+
          '<div class="acc-content"><div class="acc-block"><div class="acc-label">Ce que tu entends peut-être souvent en toi</div><div class="cr-tags">'+tagsHtml+'</div></div></div></div>'+
      '</div></div>';
  resultsEl.classList.add("show");
  bindAcc(resultsEl);
  setTimeout(function(){
    resultsEl.querySelectorAll(".score-fill").forEach(function(el){el.style.width=el.dataset.pct+"%";});
    resultsEl.scrollIntoView({behavior:"smooth",block:"start"});
  },120);
}
nextBtn.addEventListener("click",function(){
  errBox.textContent="";
  if(!answered()){errBox.textContent="Choisis une réponse pour continuer.";return;}
  if(cur<tot){cur++;update();return;}
  showResults();
});
prevBtn.addEventListener("click",function(){errBox.textContent="";if(cur>1){cur--;update();}});
update();

document.querySelectorAll('.croy-btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    this.closest('.croy-item').classList.toggle('open');
  });
});

})();
</script>
