var PROFILES = {
  reg:{
    profil:"Je mange par habitude",
    tagline:"Tu manges selon des règles apprises — pas toujours selon ce que ton corps demande réellement.",
    analyse:"Les règles alimentaires de ton enfance et de ton environnement guident encore tes choix sans que tu l'aies décidé. Finir son assiette. Manger aux heures fixes. Ne pas gaspiller. Ces automatismes ont été intégrés avant que tu puisses les questionner. C'est ce que tu as entendu depuis enfant donc c'est normal.",
