<style>
*{box-sizing:border-box}
:root{
  --red:#a91b18;
  --red-dark:#7a130f;
  --pink:#fff0f6;
  --pink-mid:#ffd6e8;
  --bg:#f8f7f5;
  --white:#fff;
  --g100:#f1eeea;
  --g200:#e0dcd6;
  --g400:#9e9b95;
  --g700:#4a4845;
  --g900:#1a1917;
  --font-d:'Playfair Display',Georgia,serif;
  --font-b:'DM Sans',system-ui,sans-serif;
  --r-sm:8px;
  --r-md:12px;
  --r-lg:20px;
}

#aw{
  width:100%;
  max-width:900px;
  margin:0 auto;
  font-family:var(--font-b);
  color:var(--g900);
}

/* TABS */
.aw-tabs{
  display:flex;
  background:var(--white);
  border-bottom:1.5px solid var(--g200);
  padding:0 24px;
  border-radius:var(--r-lg) var(--r-lg) 0 0;
  overflow:hidden;
}

.aw-tab{
  padding:15px 22px;
  font-family:var(--font-b);
  font-size:14px;
  font-weight:700;
  color:var(--g400);
  border:none;
  background:none;
  cursor:pointer;
  border-bottom:2.5px solid transparent;
  margin-bottom:-1.5px;
  transition:.2s;
  display:flex;
  align-items:center;
  gap:7px;
  text-transform:uppercase;
  letter-spacing:.03em;
}

.aw-tab:hover{color:var(--red)}
.aw-tab.on{color:var(--red);border-bottom-color:var(--red)}

.aw-pane{
  display:none;
  background:var(--bg);
  border-radius:0 0 var(--r-lg) var(--r-lg);
}

.aw-pane.on{display:block}

/* CARTE */
.map-wrap{
  padding:20px;
}

.map-intro{
  background:#fff;
  border:1px solid var(--g200);
  border-radius:16px;
  padding:14px 16px;
  margin-bottom:14px;
  text-align:center;
}

.map-intro h2{
  font-family:var(--font-d);
  color:var(--red-dark);
  font-size:28px;
  margin:0 0 6px;
}

.map-intro p{
  color:var(--g700);
  font-size:13px;
  line-height:1.5;
  margin:0;
}

#aw-map{
  width:100%;
  height:430px;
  min-height:430px;
  border-radius:15px;
  background:white;
  overflow:hidden;
  border:1px solid var(--g200);
  z-index:1;
}

.map-loader{
  text-align:center;
  padding:12px;
  color:var(--g400);
  font-size:13px;
}

/* RECETTES */
.rec-wrap{padding:24px}

.rec-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  margin-bottom:20px;
  flex-wrap:wrap;
  gap:12px;
}

.rec-title{
  font-family:var(--font-d);
  font-size:30px;
  color:var(--red-dark);
  line-height:1;
  margin:0;
}

.rec-subtitle{
  font-size:13px;
  color:var(--g400);
  margin-top:4px;
}

.selected-country{
  display:none;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  background:var(--pink);
  border:1px solid var(--pink-mid);
  border-radius:var(--r-md);
  padding:12px 14px;
  margin-bottom:14px;
  color:var(--red-dark);
  font-size:13px;
  font-weight:700;
}

.selected-country.show{
  display:flex;
}

.clear-country{
  border:none;
  background:#fff;
  color:var(--red);
  border-radius:999px;
  padding:7px 12px;
  font-size:12px;
  font-weight:800;
  cursor:pointer;
}

/* FAVORIS */
.fav-toggle-wrap{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  background:#fff;
  border:1px solid var(--g200);
  border-radius:var(--r-md);
  padding:10px;
  margin-bottom:14px;
  flex-wrap:wrap;
}

.fav-toggle-left{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.fav-view-btn{
  border:none;
  border-radius:999px;
  padding:9px 14px;
  font-size:13px;
  font-weight:800;
  cursor:pointer;
  background:var(--bg);
  color:var(--g700);
  transition:.2s;
}

.fav-view-btn:hover{
  color:var(--red);
  background:var(--pink);
}

.fav-view-btn.on{
  background:var(--red);
  color:#fff;
}

.fav-count{
  font-size:12px;
  color:var(--g400);
  font-weight:700;
}

/* FILTRES */
.rec-filters{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-bottom:22px;
  padding:16px;
  background:#fff;
  border-radius:var(--r-md);
  border:1px solid var(--g200);
}

.rec-filters select,
.rec-filters input[type=search]{
  padding:8px 12px;
  border:1.5px solid var(--g200);
  border-radius:var(--r-sm);
  font-family:var(--font-b);
  font-size:13px;
  color:var(--g700);
  background:var(--bg);
  cursor:pointer;
  transition:border-color .2s;
  outline:none;
}

.rec-filters select:focus,
.rec-filters input:focus{
  border-color:var(--red);
}

.rec-filters input[type=search]{
  flex:1;
  min-width:160px;
}

/* CARTES RECETTES */
.rec-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
  gap:16px;
}

.r-card{
  background:#fff;
  border-radius:var(--r-md);
  overflow:hidden;
  cursor:pointer;
  transition:transform .2s,box-shadow .2s;
  border:1px solid var(--g200);
  position:relative;
}

.r-card:hover{
  transform:translateY(-3px);
  box-shadow:0 8px 28px rgba(169,27,24,.13);
}

.r-thumb{
  height:120px;
  background:var(--pink);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:54px;
  transition:background .2s;
}

.r-card:hover .r-thumb{
  background:var(--pink-mid);
}

.r-body{padding:14px}

.r-country{
  font-size:11px;
  font-weight:700;
  color:var(--red);
  letter-spacing:.06em;
  text-transform:uppercase;
  margin-bottom:3px;
}

.r-name{
  font-family:var(--font-d);
  font-size:16px;
  color:var(--g900);
  margin-bottom:9px;
  line-height:1.3;
}

.r-meta{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  margin-bottom:9px;
}

.badge{
  font-size:11px;
  padding:3px 9px;
  border-radius:20px;
  font-weight:700;
}

.b-time{background:#e8f2fd;color:#1360a0}
.b-facile{background:#e6f5e6;color:#196a19}
.b-moyen{background:#fff2df;color:#9a5c08}
.b-difficile{background:#fde8e8;color:#a01818}
.b-repas{background:var(--pink);color:var(--red)}

.r-tags{
  display:flex;
  gap:4px;
  flex-wrap:wrap;
}

.tag{
  font-size:10px;
  padding:2px 8px;
  background:var(--g100);
  color:var(--g400);
  border-radius:20px;
  font-weight:700;
}

.fav-btn{
  position:absolute;
  top:9px;
  right:9px;
  background:#fff;
  border:none;
  border-radius:50%;
  width:32px;
  height:32px;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  font-size:15px;
  box-shadow:0 2px 8px rgba(0,0,0,.1);
  transition:transform .15s;
  z-index:5;
}

.fav-btn:hover{transform:scale(1.18)}

.rec-empty{
  text-align:center;
  padding:60px 20px;
  color:var(--g400);
  grid-column:1/-1;
}

.rec-empty-icon{
  font-size:48px;
  margin-bottom:12px;
}

.rec-empty-title{
  font-family:var(--font-d);
  font-size:20px;
  color:var(--g700);
  margin-bottom:8px;
}

/* ── MODAL — STYLE ORIGINAL COMPACT ── */
.modal-overlay{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(26,25,23,.62);
  z-index:100000;
  overflow-y:auto;
  padding:40px 16px;
}

.modal-overlay.open{
  display:flex;
  animation:fadeIn .2s;
  align-items:flex-start;
  justify-content:center;
}

@keyframes fadeIn{
  from{opacity:0}
  to{opacity:1}
}

.modal-box{
  background:#fff;
  border-radius:var(--r-lg);
  max-width:640px;
  width:100%;
  overflow:hidden;
  animation:slideUp .25s ease;
  margin:auto;
  box-shadow:0 18px 60px rgba(26,25,23,.22);
}

@keyframes slideUp{
  from{opacity:0;transform:translateY(24px)}
  to{opacity:1;transform:translateY(0)}
}

.modal-hd{
  background:var(--pink);
  padding:28px 32px;
  position:relative;
  display:flex;
  gap:20px;
  align-items:flex-start;
}

.modal-emoji{
  font-size:64px;
  line-height:1;
  flex-shrink:0;
}

.modal-close{
  position:absolute;
  top:14px;
  right:14px;
  background:#fff;
  border:none;
  border-radius:50%;
  width:36px;
  height:36px;
  font-size:20px;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--g700);
  transition:background .15s;
  font-weight:600;
}

.modal-close:hover{
  background:var(--g200);
}

.modal-title{
  font-family:var(--font-d);
  font-size:24px;
  color:var(--red-dark);
  line-height:1.2;
  margin:0 0 5px;
}

.modal-country-lbl{
  font-size:12px;
  color:var(--red);
  font-weight:500;
  letter-spacing:.05em;
  text-transform:uppercase;
  margin-bottom:8px;
  padding-right:42px;
}

.modal-desc{
  font-size:13px;
  color:var(--g700);
  line-height:1.6;
  margin:0;
}

.modal-meta{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  margin-top:10px;
}

.modal-meta .badge{
  font-size:11px;
  padding:3px 9px;
  border-radius:20px;
  font-weight:500;
}

.modal-meta .tag{
  font-size:10px;
  padding:2px 8px;
  background:var(--g100);
  color:var(--g400);
  border-radius:20px;
  font-weight:500;
}

.modal-bd{
  padding:24px 32px;
}

.modal-sec{
  font-family:var(--font-d);
  font-size:18px;
  color:var(--red-dark);
  margin:0 0 14px;
  padding-bottom:8px;
  border-bottom:1.5px solid var(--pink-mid);
}

.modal-sec small{
  font-family:var(--font-b);
  font-size:13px;
  font-weight:400;
  color:var(--g400);
}

.ingr-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-bottom:28px;
}

.ingr-item{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  padding:8px 12px;
  background:var(--bg);
  border-radius:var(--r-sm);
  font-size:13px;
}

.ingr-name{
  color:var(--g700);
}

.ingr-qty{
  color:var(--red);
  font-weight:500;
  text-align:right;
  white-space:nowrap;
}

.steps-list{
  margin-bottom:28px;
}

.step{
  display:flex;
  gap:14px;
  margin-bottom:14px;
  align-items:flex-start;
}

.step-n{
  width:28px;
  height:28px;
  border-radius:50%;
  background:var(--red);
  color:#fff;
  font-size:12px;
  font-weight:500;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}

.step-t{
  font-size:13px;
  color:var(--g700);
  line-height:1.6;
  padding-top:4px;
}

.nutri-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  padding:16px;
  background:var(--pink);
  border-radius:var(--r-md);
}

.nutri-item{
  text-align:center;
}

.nutri-val{
  font-family:var(--font-d);
  font-size:22px;
  color:var(--red);
  display:block;
}

.nutri-lbl{
  font-size:11px;
  color:var(--g400);
  text-transform:uppercase;
  letter-spacing:.05em;
}

/* TOAST */
.toast{
  position:fixed;
  bottom:24px;
  left:50%;
  transform:translateX(-50%) translateY(80px);
  background:var(--g900);
  color:#fff;
  padding:11px 20px;
  border-radius:var(--r-md);
  font-size:13px;
  z-index:200000;
  transition:transform .3s;
  pointer-events:none;
}

.toast.show{
  transform:translateX(-50%) translateY(0);
}

/* MOBILE */
@media(max-width:580px){
  .aw-tabs{
    padding:0 12px;
  }

  .aw-tab{
    flex:1;
    justify-content:center;
    padding:14px 10px;
    font-size:13px;
  }

  .map-wrap,
  .rec-wrap{
    padding:14px;
  }

  #aw-map{
    height:380px;
    min-height:380px;
  }

  .map-intro h2{
    font-size:24px;
  }

  .rec-grid{
    grid-template-columns:1fr 1fr;
    gap:10px;
  }

  .r-thumb{
    height:96px;
    font-size:42px;
  }

  .r-body{
    padding:11px;
  }

  .r-name{
    font-size:14px;
  }

  .badge{
    font-size:10px;
    padding:3px 7px;
  }

  .selected-country{
    align-items:flex-start;
    flex-direction:column;
  }

  .fav-toggle-wrap{
    align-items:flex-start;
    flex-direction:column;
  }

  .ingr-grid{
    grid-template-columns:1fr;
  }

  .nutri-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .modal-overlay{
    padding:20px 12px;
  }

  .modal-hd{
    flex-direction:column;
    padding:24px 22px;
  }

  .modal-emoji{
    font-size:52px;
  }

  .modal-title{
    font-size:22px;
  }

  .modal-desc{
    font-size:13px;
  }

  .modal-bd{
    padding:22px;
  }
}
