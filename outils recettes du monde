<script>
(function(){

let countriesData = {};
let allRecipes = [];
let favorites = JSON.parse(localStorage.getItem('aw-favs') || '[]');
let showOnlyFavorites = false;
let mapInstance = null;
let markersLayer = null;
let geoLayer = null;

const DATA_URL = "https://stagiaire94260.github.io/alimentation-monde/countriesdata.json";
const GEO_URL = "https://raw.githubusercontent.com/johan/world.geo.json/master/countries.geo.json";

const REPAS_LABEL = {
  petitdej:"Petit-déjeuner",
  dej:"Déjeuner",
  collation:"Collation",
  diner:"Dîner"
};

/* INIT */
document.addEventListener('DOMContentLoaded', startApp);

async function startApp(){
  try{
    await loadLeafletScript();
    await loadCountriesData();

    initMap();

    collectRecipes();
    populateCountryFilter();
    updateFavoriteCount();
    filterRecipes();

    setTimeout(function(){
      if(mapInstance) mapInstance.invalidateSize();
    }, 300);
}catch(e){
  console.error(e);
  const loader = document.getElementById('map-loader');
  if(loader) loader.textContent = "La carte n'a pas pu se charger. Vérifie Leaflet ou le JSON.";
}
}

/* Charge Leaflet JS si Systeme.io ne le charge pas correctement */
function loadLeafletScript(){
  return new Promise(function(resolve, reject){
    if(window.L){
      resolve();
      return;
    }

    const existing = document.querySelector('script[data-leaflet-loader="true"]');

    if(existing){
      existing.addEventListener('load', resolve);
      existing.addEventListener('error', reject);
      return;
    }

    const script = document.createElement('script');
    script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
    script.setAttribute('data-leaflet-loader', 'true');
    script.onload = resolve;
    script.onerror = reject;
    document.body.appendChild(script);
  });
}

/* Charge le JSON GitHub */
async function loadCountriesData(){
  const res = await fetch(DATA_URL);

  if(!res.ok){
    throw new Error("Impossible de charger le JSON GitHub");
  }

  countriesData = await res.json();
}

/* MAP */
function initMap(){
  const loader = document.getElementById('map-loader');

  mapInstance = L.map('aw-map', {
    center:[20,0],
    zoom:2,
    minZoom:1,
    maxZoom:5,
    scrollWheelZoom:false
  });

  markersLayer = L.layerGroup().addTo(mapInstance);

  fetch(GEO_URL)
    .then(function(res){ return res.json(); })
    .then(function(geojson){
      geoLayer = L.geoJSON(geojson, {
        style:function(){
          return {
            fillColor:"#fbc4e3",
            color:"#fff",
            weight:1,
            fillOpacity:.75
          };
        },
        onEachFeature:function(feature, layer){
          layer.on('mouseover', function(){
            this.setStyle({fillOpacity:1});
          });

          layer.on('mouseout', function(){
            this.setStyle({fillOpacity:.75});
          });
        }
      }).addTo(mapInstance);

      addMarkers();

      if(loader) loader.style.display = 'none';

      setTimeout(function(){
        mapInstance.invalidateSize();
      }, 200);
    })
    .catch(function(err){
      console.warn("GeoJSON indisponible :", err);
      addMarkers();

      if(loader) loader.style.display = 'none';
    });
}

function addMarkers(){
  if(!mapInstance || !markersLayer) return;

  markersLayer.clearLayers();

  Object.keys(countriesData).forEach(function(continent){
    Object.keys(countriesData[continent]).forEach(function(pays){
      const d = countriesData[continent][pays];

      if(!d || !Array.isArray(d.coords)) return;

      const recipeCount = Array.isArray(d.recettes) ? d.recettes.length : 0;

      const marker = L.circleMarker(d.coords, {
        radius:7,
        fillColor:"#a91b18",
        color:"#fff",
        weight:2,
        fillOpacity:1
      }).addTo(markersLayer);

      marker.bindPopup(`
        <div style="font-family:Arial,sans-serif;font-size:14px;line-height:1.5;max-width:220px;padding:10px;background:#fff0f6;border-radius:10px;">
          <h3 style="margin:0 0 6px;color:#a91b18;font-size:16px;">${escapeHTML(pays)}</h3>
          <p style="margin:0 0 8px;color:#4a4845;">
            ${recipeCount > 0 ? recipeCount + " recette(s) disponible(s)" : "Recettes bientôt disponibles"}
          </p>
          <button
            type="button"
            onclick="selectCountryFromMap('${escapeAttr(continent)}','${escapeAttr(pays)}')"
            style="border:none;background:#a91b18;color:#fff;border-radius:999px;padding:7px 11px;font-size:12px;font-weight:bold;cursor:pointer;">
            Voir les recettes
          </button>
        </div>
      `);

      marker.on('click', function(){
        selectCountryFromMap(continent, pays);
      });
    });
  });
}

/* TABS */
window.switchTab = function(tab){
  document.getElementById('tab-btn-map').classList.toggle('on', tab === 'map');
  document.getElementById('tab-btn-recipes').classList.toggle('on', tab === 'recipes');

  document.getElementById('pane-map').classList.toggle('on', tab === 'map');
  document.getElementById('pane-recipes').classList.toggle('on', tab === 'recipes');

  if(tab === 'map' && mapInstance){
    setTimeout(function(){
      mapInstance.invalidateSize();
    }, 80);
  }
};

/* Clic pays depuis carte */
window.selectCountryFromMap = function(continent, pays){
  const fCont = document.getElementById('f-continent');
  const fPays = document.getElementById('f-pays');

  showOnlyFavorites = false;
  document.getElementById('view-all-btn').classList.add('on');
  document.getElementById('view-favs-btn').classList.remove('on');

  fCont.value = continent;
  updateCountryFilter();

  setTimeout(function(){
    fPays.value = pays;
    filterRecipes();
    updateSelectedCountryBox(pays);
    switchTab('recipes');
    showToast("Recettes de " + pays);
  }, 0);
};

/* RECETTES */
function collectRecipes(){
  allRecipes = [];

  for(const cont in countriesData){
    for(const pays in countriesData[cont]){
      const recs = countriesData[cont][pays].recettes;

      if(Array.isArray(recs)){
        recs.forEach(function(r){
          if(r && r.id && !allRecipes.find(function(a){ return a.recette.id === r.id; })){
            allRecipes.push({
              continent:cont,
              pays:pays,
              recette:r
            });
          }
        });
      }
    }
  }
}

window.updateCountryFilter = function(){
  const cont = document.getElementById('f-continent').value;
  const ps = document.getElementById('f-pays');

  const previous = ps.value;

  ps.innerHTML = '<option value="">Tous les pays</option>';

  const paysSet = new Set();

  allRecipes.forEach(function(item){
    if(!cont || item.continent === cont){
      paysSet.add(item.pays);
    }
  });

  Array.from(paysSet).sort().forEach(function(p){
    const o = document.createElement('option');
    o.value = p;
    o.textContent = p;
    ps.appendChild(o);
  });

  if(previous && paysSet.has(previous)){
    ps.value = previous;
  }
};

function populateCountryFilter(){
  window.updateCountryFilter();
}

/* FAVORIS VIEW */
window.setFavoriteView = function(onlyFavs){
  showOnlyFavorites = onlyFavs;

  document.getElementById('view-all-btn').classList.toggle('on', !onlyFavs);
  document.getElementById('view-favs-btn').classList.toggle('on', onlyFavs);

  filterRecipes();
};

window.filterRecipes = function(){
  const q = document.getElementById('search-input').value.toLowerCase().trim();
  const cont = document.getElementById('f-continent').value;
  const pays = document.getElementById('f-pays').value;
  const repas = document.getElementById('f-repas').value;
  const diff = document.getElementById('f-diff').value;

  const res = allRecipes.filter(function(item){
    const r = item.recette;
    const tags = (r.tags || []).join(' ').toLowerCase();
    const isFav = favorites.includes(r.id);

    return (
      (!showOnlyFavorites || isFav) &&
      (!cont || item.continent === cont) &&
      (!pays || item.pays === pays) &&
      (!repas || r.repas === repas) &&
      (!diff || r.difficulte === diff) &&
      (
        !q ||
        (r.nom || '').toLowerCase().includes(q) ||
        item.pays.toLowerCase().includes(q) ||
        tags.includes(q)
      )
    );
  });

  updateSelectedCountryBox(pays);
  renderCards(res);
};

function renderCards(list){
  const grid = document.getElementById('rec-grid');
  const count = document.getElementById('rec-count');

  count.textContent =
    list.length === 0 ? 'Aucune recette trouvée' :
    list.length === 1 ? '1 recette' :
    list.length + ' recettes';

  if(!list.length){
    grid.innerHTML = `
      <div class="rec-empty">
        <div class="rec-empty-icon">${showOnlyFavorites ? '🤍' : '🔍'}</div>
        <div class="rec-empty-title">
          ${showOnlyFavorites ? 'Aucun favori pour le moment' : 'Aucune recette trouvée'}
        </div>
        <p>
          ${
            showOnlyFavorites
              ? 'Clique sur le cœur d’une recette pour la retrouver ici.'
              : 'Ce pays n’a pas encore de recettes ou tes filtres sont trop précis.'
          }
        </p>
      </div>
    `;
    return;
  }

  grid.innerHTML = '';

  list.forEach(function(item){
    const r = item.recette;
    const isFav = favorites.includes(r.id);

    const card = document.createElement('div');
    card.className = 'r-card';

    card.innerHTML = `
      <button class="fav-btn" type="button" data-id="${escapeAttr(r.id)}">${isFav ? '❤️' : '🤍'}</button>

      <div class="r-thumb">${r.emoji || '🍽️'}</div>

      <div class="r-body">
        <div class="r-country">${escapeHTML(item.pays)}</div>
        <div class="r-name">${escapeHTML(r.nom || 'Recette')}</div>

        <div class="r-meta">
          <span class="badge b-time">⏱ ${escapeHTML(String(r.temps || '-'))} min</span>
          <span class="badge b-${escapeHTML(r.difficulte || 'facile')}">${escapeHTML(r.difficulte || 'facile')}</span>
          <span class="badge b-repas">${escapeHTML(REPAS_LABEL[r.repas] || r.repas || 'Repas')}</span>
        </div>

        <div class="r-tags">
          ${(r.tags || []).map(function(t){ return `<span class="tag">${escapeHTML(t)}</span>`; }).join('')}
        </div>
      </div>
    `;

   card.addEventListener('click', function(e){
  if(e.target.closest('.fav-btn')) return;
  openModal(item.continent, item.pays, r, card);
});

    card.querySelector('.fav-btn').addEventListener('click', function(e){
      e.stopPropagation();
      toggleFav(r.id, e.currentTarget);
    });

    grid.appendChild(card);
  });
}

function updateSelectedCountryBox(pays){
  const box = document.getElementById('selected-country-box');
  const txt = document.getElementById('selected-country-text');

  if(pays){
    box.classList.add('show');
    txt.textContent = "Recettes sélectionnées : " + pays;
  }else{
    box.classList.remove('show');
    txt.textContent = "";
  }
}

window.clearCountrySelection = function(){
  document.getElementById('f-continent').value = '';
  updateCountryFilter();
  document.getElementById('f-pays').value = '';
  filterRecipes();
};

