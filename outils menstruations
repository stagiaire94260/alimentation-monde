        { title:'Magnésium — système nerveux et confort', desc:'C’est l’un des nutriments les plus cohérents ici.', items:['chocolat noir','amandes','graines de courge','cacao'] },
        { title:'Vitamine B6 — soutien des neurotransmetteurs', desc:'Intéressante dans une phase où l’humeur et les envies peuvent bouger.', items:['banane','pommes de terre','volaille','légumineuses'] },
        { title:'Tryptophane / protéines — satiété et terrain', desc:'Base importante quand les fringales commencent à grimper.', items:['dinde','œufs','poisson','yaourt grec'] },
        { title:'Calcium — phase PMS friendly', desc:'Très pertinent à mettre en avant ici.', items:['skyr','yaourt','fromage blanc','sardines avec arêtes'] },
        { title:'Glucides complexes — stabilité', desc:'Ici, ils ne sont pas “en trop”. Ils sont souvent exactement ce qu’il manque.', items:['avoine','riz','quinoa','patate douce'] },
        { title:'Potassium / aliments riches en eau — sensation de légèreté', desc:'À intégrer quand tu te sens gonflée ou lourde.', items:['banane','concombre','courgette','kiwi'] },
        { title:'Bissap — rituel de phase lutéale', desc:'C’est probablement la phase où il a le plus de sens dans ton storytelling : hydratation, rituel, légèreté.', items:['bissap chaud au gingembre','bissap froid peu sucré'], bissap:true }
      ],
      bienfaits:[
        { title:'Pourquoi le chocolat noir n’est pas “juste une envie”', text:'En phase lutéale, beaucoup de femmes ressentent plus d’envies de sucre, de gras ou de chocolat. Le chocolat noir apporte notamment du magnésium, ce qui en fait un aliment cohérent dans cette phase, au-delà du simple côté plaisir.' },
        { title:'Pourquoi la banane est intéressante ici', text:'La banane n’est pas magique, mais elle coche plusieurs cases : glucides, potassium, vitamine B6. Donc oui, elle peut s’intégrer intelligemment dans une stratégie anti-fringales, énergie et confort.' },
        { title:'Pourquoi les glucides complexes deviennent stratégiques', text:'Quand tu as plus faim, plus d’envies et une humeur plus fragile, les repas trop légers empirent souvent tout. Les glucides complexes aident à rendre cette phase plus stable, plus rassasiante et plus vivable.' },
        { title:'Pourquoi les fibres aident quand tu te sens lourde', text:'Elles soutiennent le transit et participent à une meilleure élimination digestive. Dans une phase où beaucoup se sentent gonflées, ballonnées ou ralenties, elles deviennent particulièrement intéressantes.' },
        { title:'Pourquoi calcium + magnésium + protéines font équipe', text:'Le calcium est pertinent dans une logique PMS. Le magnésium soutient davantage le système nerveux et le confort. Les protéines, elles, aident à la satiété et évitent de finir la journée en mode survie.' }
      ],
      recettes:[
        { title:'Bowl lutéal solide', text:'Riz + saumon + avocat + concombre + graines de courge. Satiété, magnésium, bons lipides et structure.' },
        { title:'Assiette anti-fringale', text:'Patate douce rôtie + œufs + légumes verts. Simple, rassasiant, stable.' },
        { title:'Petit-déj ou collation de phase', text:'Yaourt grec + banane + cacao + amandes.' },
        { title:'Porridge lutéal', text:'Avoine + banane + chocolat noir. La vraie version “je sécurise ma phase” au lieu de culpabiliser.' },
        { title:'Recette bissap', text:'Bissap chaud avec gingembre et un peu de miel en rituel de fin de journée.' }
      ],
      note:'La phase lutéale n’est pas un moment où tu manques de discipline. C’est un moment où ton corps te demande plus de structure, plus de soutien et parfois un peu plus de nourriture, tout simplement.'
    }
  ];

  const geometry = [
    { key:'regles', start:-90, end:0, labelAngle:-45 },
    { key:'folliculaire', start:0, end:135, labelAngle:67.5 },
    { key:'ovulation', start:135, end:180, labelAngle:157.5 },
    { key:'luteale', start:180, end:270, labelAngle:225 }
  ];

  const tabs = Array.from(document.querySelectorAll('.popup-tab'));
  const popup = document.getElementById('phase-popup');
  const segmentGroup = document.getElementById('wheel-segments');
  const labelGroup = document.getElementById('wheel-labels');

  const phaseBadge = document.getElementById('phase-badge');
  const phaseTitle = document.getElementById('phase-title');
  const phaseIntro = document.getElementById('phase-intro');

  const tabHormones = document.getElementById('tab-hormones');
  const tabAliments = document.getElementById('tab-aliments');
  const tabBienfaits = document.getElementById('tab-bienfaits');
  const tabRecettes = document.getElementById('tab-recettes');

  let activePhaseKey = null;

  function polarToCartesian(cx, cy, r, angleDeg){
    const angleRad = (angleDeg - 90) * Math.PI / 180;
    return {
      x: cx + (r * Math.cos(angleRad)),
      y: cy + (r * Math.sin(angleRad))
    };
  }

  function arcPath(cx, cy, innerR, outerR, startAngle, endAngle){
    const startOuter = polarToCartesian(cx, cy, outerR, endAngle);
    const endOuter = polarToCartesian(cx, cy, outerR, startAngle);
    const startInner = polarToCartesian(cx, cy, innerR, endAngle);
    const endInner = polarToCartesian(cx, cy, innerR, startAngle);
    const largeArcFlag = endAngle - startAngle <= 180 ? "0" : "1";

    return [
      "M", startOuter.x, startOuter.y,
      "A", outerR, outerR, 0, largeArcFlag, 0, endOuter.x, endOuter.y,
      "L", endInner.x, endInner.y,
      "A", innerR, innerR, 0, largeArcFlag, 1, startInner.x, startInner.y,
      "Z"
    ].join(" ");
  }

  function renderWheel(){
    geometry.forEach(g => {
      const ph = phases.find(p => p.key === g.key);
      const basePath = arcPath(250, 250, 124, 214, g.start, g.end);

      const path = document.createElementNS('http://www.w3.org/2000/svg','path');
      path.setAttribute('d', basePath);
      path.setAttribute('fill', ph.color);
      path.setAttribute('stroke', 'rgba(255,255,255,.50)');
      path.setAttribute('stroke-width', '2');
      path.setAttribute('class', 'wheel-segment');
      path.setAttribute('data-key', ph.key);
      path.setAttribute('aria-label', ph.short);
      segmentGroup.appendChild(path);

      const point = polarToCartesian(250, 250, 170, g.labelAngle);
      const text = document.createElementNS('http://www.w3.org/2000/svg','g');
      text.setAttribute('class', 'wheel-label');
      text.setAttribute('transform', `translate(${point.x}, ${point.y})`);
      const textColor = ph.labelColor || '#ffffff';
      const dayColor = ph.labelColor === '#7F1210' ? 'rgba(127,18,16,.82)' : 'rgba(255,255,255,.94)';
      text.innerHTML = `
        <text class="wheel-label-title" fill="${textColor}" text-anchor="middle" y="-2">${ph.short}</text>
        <text class="wheel-label-days" fill="${dayColor}" text-anchor="middle" y="16">${ph.days}</text>
      `;
      labelGroup.appendChild(text);
    });
  }

  function renderHormones(ph){
    return `
      <div class="info-block">
        <div class="info-label">Ce qui se passe</div>
        <div class="info-text">${ph.hormonesIntro}</div>
      </div>
      <div class="info-block">
        <div class="info-label">Niveaux hormonaux</div>
        ${ph.hormones.map(h => `
          <div class="hormone-row">
            <div class="hormone-name">${h.name}</div>
            <div class="hormone-track">
              <div class="hormone-fill" style="width:${h.level}%; background:${h.color};"></div>
            </div>
            <div class="hormone-level">${h.label}</div>
          </div>
        `).join('')}
      </div>
      <div class="info-block">
        <div class="info-label">Le lien avec ton alimentation</div>
        <div class="info-text">${ph.whyEat}</div>
      </div>
    `;
  }

  function renderAliments(ph){
    return `
      <div class="accordion">
        ${ph.aliments.map((cat, index) => `
          <div class="acc-item ${index === 0 ? 'open' : ''}">
            <button class="acc-btn" type="button">
              <span>${cat.title}</span>
              <em>+</em>
            </button>
            <div class="acc-content">
              <div class="cat-desc">${cat.desc}</div>
              <div class="pill-wrap">
                ${cat.items.map(item => `<span class="pill ${cat.bissap ? 'bissap' : ''}">${item}</span>`).join('')}
              </div>
            </div>
          </div>
        `).join('')}
      </div>
    `;
  }

  function renderBienfaits(ph){
    return `
      <div class="accordion">
        ${ph.bienfaits.map((item, index) => `
          <div class="acc-item ${index === 0 ? 'open' : ''}">
            <button class="acc-btn" type="button">
              <span>${item.title}</span>
              <em>+</em>
            </button>
            <div class="acc-content">
              <div class="benefit-text">${item.text}</div>
            </div>
          </div>
        `).join('')}
      </div>
    `;
  }

  function renderRecettes(ph){
    return `
      <div class="accordion">
        ${ph.recettes.map((item, index) => `
          <div class="acc-item ${index === 0 ? 'open' : ''}">
            <button class="acc-btn" type="button">
              <span>${item.title}</span>
              <em>+</em>
            </button>
            <div class="acc-content">
              <div class="recipe-text">${item.text}</div>
            </div>
          </div>
        `).join('')}
      </div>
      <div class="phase-note">${ph.note}</div>
    `;
  }

  function bindAccordions(){
    document.querySelectorAll('.acc-btn').forEach(btn => {
      btn.addEventListener('click', function(){
        this.parentElement.classList.toggle('open');
      });
    });
  }

  function switchTab(tabName){
    tabs.forEach(btn => btn.classList.toggle('active', btn.dataset.tab === tabName));
    document.querySelectorAll('.popup-panel').forEach(panel => panel.classList.remove('active'));
    document.getElementById('tab-' + tabName).classList.add('active');
  }

  tabs.forEach(btn => {
    btn.addEventListener('click', function(){
      switchTab(this.dataset.tab);
    });
  });

  function setActiveSegment(key){
    document.querySelectorAll('.wheel-segment').forEach(seg => {
      seg.classList.toggle('is-active', seg.dataset.key === key);
    });
  }

  function showPopup(ph, anchorEvent){
    phaseBadge.textContent = ph.badge;
    phaseTitle.textContent = ph.title;
    phaseTitle.style.color = ph.color;
    phaseBadge.style.color = ph.color;
    phaseBadge.style.background = ph.color + '12';
    phaseBadge.style.borderColor = ph.color + '26';

    phaseIntro.textContent = ph.intro;
    tabHormones.innerHTML = renderHormones(ph);
    tabAliments.innerHTML = renderAliments(ph);
    tabBienfaits.innerHTML = renderBienfaits(ph);
    tabRecettes.innerHTML = renderRecettes(ph);
    bindAccordions();
    switchTab('hormones');
    setActiveSegment(ph.key);
    activePhaseKey = ph.key;

    popup.style.display = 'block';

    const isMobile = window.innerWidth <= 640;

    if(isMobile){
      popup.style.left = '12px';
      popup.style.right = '12px';
      popup.style.top = 'auto';
      popup.style.bottom = '12px';
      popup.style.width = 'auto';
      popup.style.opacity = '0';

      requestAnimationFrame(() => {
        popup.classList.add('is-open');
        popup.style.opacity = '1';
      });
      return;
    }

    popup.classList.remove('is-open');
    popup.style.width = 'min(92vw, 440px)';
    popup.style.maxWidth = '440px';

    const margin = 14;
    const vw = window.innerWidth;
    const vh = window.innerHeight;

    const popupRect = popup.getBoundingClientRect();
    const popupWidth = popupRect.width || 440;
    const popupHeight = popupRect.height || 320;

    let clientX = vw / 2;
    let clientY = vh / 2;

    if(anchorEvent){
      clientX = anchorEvent.clientX;
      clientY = anchorEvent.clientY;
    }

    let left = clientX + 18;
    if (left + popupWidth > vw - margin) left = clientX - popupWidth - 18;
    if (left < margin) left = margin;

    let top = clientY - (popupHeight / 2);
    if (top + popupHeight > vh - margin) top = vh - popupHeight - margin;
    if (top < margin) top = margin;

    popup.style.left = `${left}px`;
    popup.style.right = 'auto';
    popup.style.top = `${top}px`;
    popup.style.bottom = 'auto';
    popup.style.transform = 'scale(.96)';
    popup.style.opacity = '0';

    requestAnimationFrame(() => {
      popup.style.transform = 'scale(1)';
      popup.style.opacity = '1';
    });
  }

  function hidePopup(){
    const isMobile = window.innerWidth <= 640;

    if(isMobile){
      popup.classList.remove('is-open');
      popup.style.opacity = '0';
      setTimeout(() => {
        popup.style.display = 'none';
      }, 220);
    } else {
      popup.style.transform = 'scale(.96)';
      popup.style.opacity = '0';
      setTimeout(() => {
        popup.style.display = 'none';
      }, 220);
    }

    activePhaseKey = null;
    setActiveSegment(null);
  }

  window.closePopup = function() {
    hidePopup();
  };

  document.addEventListener('click', function(e){
    const clickedInsidePopup = popup.contains(e.target);
    const clickedSegment = e.target.closest('.wheel-segment');
    if (popup.style.display !== 'none' && popup.style.display !== '' && !clickedInsidePopup && !clickedSegment) {
      hidePopup();
    }
  });

  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && popup.style.display === 'block'){
      hidePopup();
    }
  });

  segmentGroup.addEventListener('click', function(e){
    const seg = e.target.closest('.wheel-segment');
    if(!seg) return;

    const key = seg.dataset.key;
    const ph = phases.find(p => p.key === key);
    if(!ph) return;

    if(activePhaseKey === key && popup.style.display === 'block'){
      hidePopup();
      return;
    }

    showPopup(ph, e);
  });

  renderWheel();
})();
</script>
