<!-- ======= Cycle menstruel TNH — roue 3D douce + logo centré ======= -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div id="cycle-premium">
  <div class="cycle-wheel-wrap">
    <div class="cycle-wheel" id="cycle-wheel">
      <svg id="cycle-wheel-svg" viewBox="0 0 500 500" aria-label="Cycle menstruel interactif">
        <defs>
          <radialGradient id="centerFill" cx="50%" cy="45%" r="75%">
            <stop offset="0%" stop-color="#fffefe"></stop>
            <stop offset="100%" stop-color="#f7efef"></stop>
          </radialGradient>

          <filter id="softDepth" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="10" stdDeviation="8" flood-color="#5f1212" flood-opacity=".10"/>
          </filter>

          <filter id="segmentDepth" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#4a0e10" flood-opacity=".10"/>
          </filter>
        </defs>

        <circle class="wheel-base-ring" cx="250" cy="250" r="214"></circle>
        <circle class="wheel-inner-ring" cx="250" cy="250" r="118"></circle>

        <g id="wheel-segments"></g>

        <circle cx="250" cy="250" r="102" fill="url(#centerFill)" filter="url(#softDepth)"></circle>
        <circle cx="250" cy="250" r="102" fill="none" stroke="rgba(169,27,24,.08)" stroke-width="1"></circle>

        <g class="wheel-center-logo">
          <image
            href="https://d1yei2z3i6k35z.cloudfront.net/9069669/696295d9d3781_Group332.png"
            x="196"
            y="196"
            width="108"
            height="108"
            preserveAspectRatio="xMidYMid meet"
          ></image>
        </g>

        <g id="wheel-labels"></g>
      </svg>
    </div>
  </div>

  <div id="phase-popup">
    <button id="popup-close" onclick="closePopup()" aria-label="Fermer">✕</button>

    <div class="popup-head">
      <div id="phase-badge"></div>
      <h3 id="phase-title"></h3>
      <p id="phase-intro"></p>
    </div>

    <div class="popup-tabs">
      <button class="popup-tab active" data-tab="hormones">Hormones</button>
      <button class="popup-tab" data-tab="aliments">Aliments</button>
      <button class="popup-tab" data-tab="bienfaits">Bienfaits</button>
      <button class="popup-tab" data-tab="recettes">Recettes</button>
    </div>

    <div class="popup-body">
      <div class="popup-panel active" id="tab-hormones"></div>
      <div class="popup-panel" id="tab-aliments"></div>
      <div class="popup-panel" id="tab-bienfaits"></div>
      <div class="popup-panel" id="tab-recettes"></div>
    </div>
  </div>
</div>

<style>
  #cycle-premium{
    font-family:'Inter', Helvetica, Arial, sans-serif;
    color:#3F0405;
    width:100%;
    max-width:980px;
    margin:0 auto;
    position:relative;
  }

  #cycle-premium *{
    box-sizing:border-box;
  }

  .cycle-wheel-wrap{
    display:flex;
    justify-content:center;
    align-items:center;
    padding:10px 10px 0;
  }

  .cycle-wheel{
    width:min(84vw, 620px);
    max-width:620px;
    position:relative;
  }

  #cycle-wheel-svg{
    display:block;
    width:100%;
    height:auto;
    overflow:visible;
  }

  .wheel-base-ring{
    fill:none;
    stroke:#eee1e1;
    stroke-width:22;
  }

  .wheel-inner-ring{
    fill:none;
    stroke:#f6eded;
    stroke-width:10;
  }

  .wheel-segment{
    cursor:pointer;
    transition:transform .18s ease, opacity .18s ease, filter .18s ease;
    transform-origin:250px 250px;
    filter:url(#segmentDepth);
  }

  .wheel-segment:hover{
    transform:translateY(-1px);
    opacity:.97;
  }

  .wheel-segment.is-active{
    transform:scale(1.018);
    filter:brightness(.98);
  }

  .wheel-label{
    pointer-events:none;
  }

  .wheel-label-title{
    font-size:15px;
    font-weight:800;
    fill:#fff;
    letter-spacing:-.02em;
  }

  .wheel-label-days{
    font-size:11px;
    font-weight:600;
    fill:rgba(255,255,255,.94);
  }

  .wheel-center-logo image{
    filter:drop-shadow(0 4px 10px rgba(63,4,5,.06));
  }

  #phase-popup{
    display:none;
    position:fixed;
    width:min(92vw, 440px);
    max-width:440px;
    background:#fbf6f6;
    color:#3F0405;
    border:1px solid rgba(169,27,24,.12);
    border-radius:24px;
    box-shadow:0 18px 40px rgba(63,4,5,.14);
    text-align:left;
    z-index:9999;
    overflow:hidden;
    transform:scale(.96);
    opacity:0;
    transition:transform .22s ease, opacity .22s ease;
  }

  #popup-close{
    position:absolute;
    top:14px;
    right:14px;
    border:none;
    background:#a91b18;
    color:#fff;
    border-radius:10px;
    width:28px;
    height:28px;
    cursor:pointer;
    font-weight:700;
    font-size:13px;
    line-height:1;
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:4;
  }

  .popup-head{
    padding:20px 20px 16px;
    background:#f7eeee;
    border-bottom:1px solid rgba(169,27,24,.08);
  }

  #phase-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    font-size:11px;
    font-weight:800;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:#a91b18;
    background:rgba(169,27,24,.07);
    border:1px solid rgba(169,27,24,.10);
    border-radius:999px;
    padding:7px 10px;
    margin-bottom:10px;
  }

  #phase-title{
    margin:0 0 8px;
    font-size:24px;
    line-height:1.08;
    font-weight:800;
    letter-spacing:-.03em;
    color:#3F0405;
    padding-right:34px;
  }

  #phase-intro{
    margin:0;
    font-size:13.5px;
    line-height:1.65;
    color:#6f4a4c;
  }

  .popup-tabs{
    display:flex;
    overflow-x:auto;
    background:#f5eded;
    border-bottom:1px solid rgba(169,27,24,.08);
    scrollbar-width:none;
    -webkit-overflow-scrolling:touch;
  }

  .popup-tabs::-webkit-scrollbar{
    display:none;
  }

  .popup-tab{
    border:none;
    background:transparent;
    padding:14px 14px;
    font-family:'Inter', Helvetica, Arial, sans-serif;
    font-size:12px;
    font-weight:700;
    color:#8d6a6b;
    cursor:pointer;
    white-space:nowrap;
    border-bottom:2px solid transparent;
    flex:none;
  }

  .popup-tab.active{
    color:#a91b18;
    border-bottom-color:#a91b18;
    background:#fbf6f6;
  }

  .popup-body{
    padding:18px;
    max-height:min(68vh, 620px);
    overflow:auto;
    -webkit-overflow-scrolling:touch;
  }

  .popup-panel{
    display:none;
  }

  .popup-panel.active{
    display:block;
  }

  .info-block{
    background:#fffefe;
    border:1px solid rgba(169,27,24,.10);
    border-radius:18px;
    padding:14px;
    margin-bottom:12px;
  }

  .info-block:last-child{
    margin-bottom:0;
  }

  .info-label{
    font-size:11px;
    font-weight:800;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:#a91b18;
    margin-bottom:8px;
  }

  .info-text{
    font-size:13.5px;
    line-height:1.7;
    color:#5f4445;
  }

  .hormone-row{
    display:flex;
    align-items:center;
    gap:10px;
    margin:10px 0;
  }

  .hormone-name{
    width:96px;
    flex:0 0 96px;
    font-size:12px;
    font-weight:700;
    color:#3F0405;
  }

  .hormone-track{
    flex:1;
    height:8px;
    border-radius:999px;
    background:#eee1e1;
    overflow:hidden;
  }

  .hormone-fill{
    height:100%;
    border-radius:999px;
  }

  .hormone-level{
    min-width:52px;
    text-align:right;
    font-size:11px;
    font-weight:700;
    color:#8d6a6b;
  }

  .accordion{
    display:grid;
    gap:10px;
  }

  .acc-item{
    border:1px solid rgba(169,27,24,.10);
    border-radius:16px;
    background:#fffefe;
    overflow:hidden;
  }

  .acc-btn{
    width:100%;
    border:none;
    background:#fffefe;
    padding:14px 16px;
    text-align:left;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    font-family:'Inter', Helvetica, Arial, sans-serif;
  }

  .acc-btn span{
    display:block;
    font-size:13px;
    font-weight:800;
    color:#3F0405;
    line-height:1.35;
  }

  .acc-btn em{
    font-style:normal;
    font-size:18px;
    color:#a91b18;
    flex:0 0 auto;
    transition:transform .22s ease;
  }

  .acc-item.open .acc-btn em{
    transform:rotate(45deg);
  }

  .acc-content{
    display:none;
    padding:0 16px 14px;
    border-top:1px solid rgba(169,27,24,.08);
  }

  .acc-item.open .acc-content{
    display:block;
  }

  .cat-desc,
  .benefit-text,
  .recipe-text{
    font-size:13px;
    line-height:1.7;
    color:#5f4445;
    margin-top:10px;
  }

  .pill-wrap{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top:10px;
  }

  .pill{
    display:inline-flex;
    align-items:center;
    padding:8px 11px;
    border-radius:999px;
    background:#fff;
    border:1px solid rgba(169,27,24,.10);
    color:#4c2a2b;
    font-size:12px;
    font-weight:600;
    line-height:1.2;
  }

  .pill.bissap{
    background:#70024312;
    border-color:#70024326;
    color:#700243;
  }

  .phase-note{
    margin-top:10px;
    padding:12px;
    border-radius:14px;
    background:#f3eeee;
    border:1px solid rgba(169,27,24,.08);
    font-size:12.5px;
    line-height:1.6;
    color:#6e4c4e;
  }

  @media (max-width:900px){
    .cycle-wheel{
      width:min(88vw, 560px);
    }
  }

  @media (max-width:640px){
    .cycle-wheel{
      width:min(94vw, 520px);
    }

    .wheel-label-title{
      font-size:13px;
    }

    .wheel-label-days{
      font-size:10px;
    }

    #phase-popup{
      left:12px !important;
      right:12px !important;
      top:auto !important;
      bottom:12px !important;
      width:auto;
      max-width:none;
      border-radius:22px;
      transform:translateY(18px);
    }

    #phase-popup.is-open{
      transform:translateY(0);
      opacity:1;
    }

    .popup-head{
      padding:18px 16px 14px;
    }

    .popup-body{
      padding:14px;
      max-height:calc(78vh - 145px);
    }

    #phase-title{
      font-size:21px;
    }

    .popup-tab{
      padding:12px 12px;
      font-size:11.5px;
    }

    .hormone-name{
      width:82px;
      flex:0 0 82px;
      font-size:11.5px;
    }

    .hormone-level{
      min-width:46px;
      font-size:10.5px;
    }
  }
</style>

